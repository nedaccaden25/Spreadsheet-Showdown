function decturnbuffs(board) {
  Logger.log("decturnbuffs, 3576")
  //Detect the presence of certain items
  let items = detectitems(['DURATION'], board)
  let duration = items[0]

  //Logic for buffs:
  //If the buff is set to be active, but the stat colors have not been changed -> set the colors and don't increment the counter
  //Else if the buff counter is at least 5+DURATION -> remove the buff
  //Else if the buff is set to be active -> increment the counter

  //Update TOCOL
  if (board.gettocolinitializer()==1) {
    board.settocolbuff(1)
    board.settocolinitializer('')
  } else if (board.gettocolbuff()>=5+duration) {
    board.settocolbuff(0)
  } else if (board.gettocolbuff()>0) {
    board.settocolbuff(board.gettocolbuff()+1)
  }

  //Update TOROW
  if (board.gettorowinitializer()==1) {
    board.settorowbuff(1)
    board.settorowinitializer('')
  } else if (board.gettorowbuff()>=5+duration) {
    board.settorowbuff(0)
  } else if (board.gettorowbuff()>0) {
    board.settorowbuff(board.gettorowbuff()+1)
  }

  //Update CEILING
  if (board.getceilinginitializer()==1) {
    board.setceilingbuff(1)
    board.setceilinginitializer('')
  } else if (board.getceilingbuff()>=5+duration) {
    board.setceilingbuff(0)
  } else if (board.getceilingbuff()>0) {
    board.setceilingbuff(board.getceilingbuff()+1)
  }

  //Update GROWTH
  if (board.getgrowthinitializer()==1) {
    board.setgrowthbuff(1)
    board.setgrowthinitializer('')
  } else if (board.getgrowthbuff()>=5+duration) {
    board.setgrowthbuff(0)
  } else if (board.getgrowthbuff()>0) {
    board.setgrowthbuff(board.getgrowthbuff()+1)
  }

  //Update NOW, also handle the self-damage when the buff ends
  if (board.getnowinitializer()==1) {
    board.setnowbuff(1)
    board.setnowinitializer('')
  } else if (board.getnowbuff()>=5+duration) {
    if (board.getenemycurrenthp()!=0) {board.setplayercurrenthp(Math.ceil(board.getplayercurrenthp()/4))}
    board.setnowbuff(0)
  } else if (board.getnowbuff()>0) {
    board.setnowbuff(board.getnowbuff()+1)
  }
}

function decwavebuffs(board) {
  Logger.log("decwavebuffs, 3659")
  //Detect the presence of certain items
  let items = detectitems(['DURATION'], board)
  let duration = items[0]

  //Check for TREND
  if (board.gettrendbuff()>=5+duration) {
    board.settrendbuff(0)
  } else if (board.gettrendbuff()>0) {
    board.settrendbuff(board.gettrendbuff()+1)
  }

  //Disable poisons
  board.setplayerpoison(0)
  board.setenemypoison(0)

  //Reset the enemy shield flag (This is basically only here if the enemy was killed using ISBLANK)
  board.setenemyshield(0)
}

function recalculatestats(modifyboard, board) {
  Logger.log("recalculatestats, 3687")

  //Calculate each stat independently (these return an array of [base stat of the class, stat after levels, stat after items])
  let hparray = recalchp(board)
  let atkarray = recalcatk(board)
  let defarray = recalcdef(board)
  let magarray = recalcmag(board)
  let luckarray = recalcluck(board)

  //Then handle all of the items that rely on stats being relative to each other (returns 2d array of each stat that's [stat, place])
  let temp = recalcrelative(hparray[2], atkarray[2], defarray[2], magarray[2], luckarray[2], board)
  hparray.push(temp[0][0], temp[0][1])
  atkarray.push(temp[1][0], temp[1][1])
  defarray.push(temp[2][0], temp[2][1])
  magarray.push(temp[3][0], temp[3][1])
  luckarray.push(temp[4][0], temp[4][1])

  //Then handle buffs and nerfs on your stats
  let finalhp = hparray[3]
  let finalatk = atkarray[3]
  let finaldef = defarray[3]
  let finalmag = magarray[3]
  let finalluck = luckarray[3]
  //TOCOL
  if (board.gettocolbuff()>0) {
    finalmag=finalmag+finalatk*0.5
    finalatk=finalatk*0.5
  }
  //TOROW
  else if (board.gettorowbuff()>0) {
    finalatk=finalatk+finalmag*0.5
    finalmag=finalmag*0.5
  }
  //CEILING
  if (board.getceilingbuff()>0) {finaldef=finaldef*2}
  //TREND
  if (board.gettrendbuff()>0) {finalluck=finalluck*2}
  //GROWTH
  if (board.getgrowthbuff()>0) {
    finalatk=finalatk*(1+0.2*board.getgrowthbuff())
    finaldef=finaldef*(1+0.2*board.getgrowthbuff())
    finalmag=finalmag*(1+0.2*board.getgrowthbuff())
  }
  //NOW
  if (board.getnowbuff()>0) {
    finalatk=finalatk*4
    finaldef=finaldef*4
    finalmag=finalmag*4
    finalluck=finalluck*4
  }

  //Then handle the Other type items now because their effects should apply after buffs (temp vars are used to have each items not affect the others)
  let items = detectitems(['PROB', 'CONFIDENCE', 'ROUNDUP', 'WRAPCOLS', 'WRAPROWS'], board)
  let prob = items[0]
  let confidence = items[1]
  let roundup = items[2]
  let wrapcols = items[3]
  let wraprows = items[4]
  let temphp = finalhp
  let tempatk = finalatk
  let tempdef = finaldef
  let tempmag = finalmag
  let templuck = finalluck

  if (prob>0) {
    finalatk = finalatk+(templuck*0.2*prob)
    finalmag = finalmag+(templuck*0.2*prob)
  }

  if (confidence>0) {
    finalhp = finalhp+(templuck*(confidence+1))
    finalluck = 0
  }

  if (roundup>0) {
    finaldef = finaldef+(templuck*0.1*roundup)
  }

  if (wrapcols>0) {
    finalmag = finalmag+(tempatk*0.1*wrapcols)
  }

  if (wraprows>0) {
    finalatk = finalatk+(tempmag*0.1*wraprows)
  }

  //One final rounding up, and insert these final values into the arrays
  finalhp=Math.ceil(finalhp); hparray.push(finalhp)
  finalatk=Math.ceil(finalatk); atkarray.push(finalatk)
  finaldef=Math.ceil(finaldef); defarray.push(finaldef)
  finalmag=Math.ceil(finalmag); magarray.push(finalmag)
  finalluck=Math.ceil(finalluck); luckarray.push(finalluck)

  //Only modify the board if this calculation is for the stats and not for helper text
  if (modifyboard==0) {
    //Calculate the difference between the new HP and the old HP
    let diff = finalhp-board.getplayermaxhp()

    //If your max HP has increased, change the current HP accordingly
    if (diff>=0) {board.setplayercurrenthp(Math.min(board.getplayercurrenthp()+diff, finalhp))}

    //If your max HP has decreased, don't change the current HP unless it would be larger than the new max
    else {board.setplayercurrenthp(Math.min(board.getplayercurrenthp(), finalhp))}

    //Write these values onto the board
    board.setplayermaxhp(finalhp)
    board.setplayeratk(finalatk)
    board.setplayerdef(finaldef)
    board.setplayermag(finalmag)
    board.setplayerluck(finalluck)

    //Update your healthbar in case it has changed with the recalculation
    board.updateplayerhpbar()

    //Update the spell slots in case they aren't updated (don't update if disabled or covered by a pop-up)
    let join = detectitems(['JOIN'], board)[0]

    for (let i=1; i<=12; i++) {
      if (board.getspellcolor(i)!='#000000' && board.getspellcolor(i)!='#ea9999') {
        if (join>=i-6) {board.setspellcolor(i, '#ddbc9a')}
        else {board.setspell(i, '', '', '', '#999999')}
      }
    }
  //If we aren't modifying the board, instead return the specified values
  } else {
    if (modifyboard==1) {return(hparray)}
    else if (modifyboard==2) {return(atkarray)}
    else if (modifyboard==3) {return(defarray)}
    else if (modifyboard==4) {return(magarray)}
    else if (modifyboard==5) {return(luckarray)}
  }
}

function recalchp(board) {
  Logger.log("recalchp, 3821")
  //Calculate the base HP based on your class
  let character = board.getcurrentcharacter()
  let basehp
  if (character == 'Cellblade') {basehp = 25}
  else if (character == 'Sheetmancer') {basehp = 20}
  else if (character == 'Rowgue') {basehp = 15}
  else if (character == 'Macroknight') {basehp = 30}
  else if (character == 'Stackleric') {basehp = 35}
  else if (character == 'Auditshade') {basehp = 18}
  else if (character == 'Hyperlinker') {basehp = 8}
  else if (character == 'Error') {basehp = 20}

  //Calculate how much the HP should increase due to your level
  let levelhp = basehp*(1+0.3*(board.getlevel()-1))

  //Get the items that affect your HP
  let items = detectitems(['ROUND', 'COUNT', 'MAX', 'RAND', 'DAY', 'WEEK', 'MONTH', 'YEAR'], board)
  let round = items[0]
  let count = items[1]
  let maxnum = items[2]
  let rand = items[3]
  let day = items[4]
  let week = items[5]
  let month = items[6]
  let year = items[7]

  //Time to handle each item individually
  let itemhp = levelhp
  if (round>0) {itemhp = itemhp+1*round}
  if (count>0) {itemhp = itemhp+Math.ceil(board.getnumberofitems()*count)}
  if (maxnum>0) {itemhp = itemhp*(1+0.075*maxnum)}
  if (year>0 && ((month==12 && week==4 && day==7) || board.iserrormastered())) {itemhp = itemhp*(1+year)}
  if (board.getrandhpboost()!='' && rand>0) {itemhp = itemhp*(1+0.15*board.getrandhpboost())}

  //Round up any decimal component
  levelhp=Math.ceil(levelhp)
  itemhp=Math.ceil(itemhp)

  //Return the base stat for the class, the stat with no items, and the stat after all items
  return([basehp, levelhp, itemhp])
}

