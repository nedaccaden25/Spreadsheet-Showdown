    ['STANDARDIZE', "RARITY: Script, TYPE: Support, EFFECT: Permanently reduce the enemy's highest stat by 50%", 5],
    ['SUBSTITUTE', "RARITY: Script, TYPE: Support, EFFECT: Permanently replace the enemy's ATK and DEF with yours", 10],
    ['PERCENTILE', 'RARITY: Script, TYPE: Magic, POWER: 50, EFFECT: Triple the power if you are at half HP or lower', 15],
    ['DOLLAR', 'RARITY: Script, TYPE: Standard, POWER: 7, EFFECT: You may cast this spell 1, 5, 10, or 25 times simultaneously', 100],
