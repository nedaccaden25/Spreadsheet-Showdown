function gotocredits(board) {
  Logger.log("gotocredits, 5721")
  //Set that we are in the credits
  board.setscreen(4)

  //Gain Bits and Chips depending on difficulty
  if (board.getvalue(102+board.getcurrentfilenum()*100, 22)!=1) {
    if (board.getcurrentdifficulty()=='Intern') {board.addbits(250); board.addchips(25)}
    else if (board.getcurrentdifficulty()=='Associate') {board.addbits(400); board.addchips(40)}
    else if (board.getcurrentdifficulty()=='Manager') {board.addbits(600); board.addchips(60)}
    else if (board.getcurrentdifficulty()=='Executive') {board.addbits(1000); board.addchips(100)}
    else if (board.getcurrentdifficulty()=='CEO') {board.addbits(2000); board.addchips(200)}
  }

  //Get values from the board that will be displayed on the credits screen
  //Item stuff
  let itemquantities = []
  let itemnames = []
  for (let i=1; i<=20; i++) {
    if (board.getitemquantity(i)=='') {break}
    itemquantities.push([board.getitemquantity(i)])
    itemnames.push([board.getitemname(i)])
  }
  if (itemquantities==[]) {itemquantities=[['']]; itemnames=[['none']]}

  //Spell stuff
  let spellnames = []
  let spellcharges = []
