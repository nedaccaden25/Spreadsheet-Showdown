  board.setvalues(105+filenum*100, 12, 2, 8, 0)
  board.setvalue(99+filenum*100, 23, '#d9d9d9')
  board.setvalues(99+filenum*100, 24, 18, 16, '#ffffff')

  //Load this new file
  loadfile(filenum, board)

  //wait 2 seconds, then spawn an enemy and save the game again
  board.pause(2)
  let nextmonster = selectmonster(1, stats[4], board)
  displaymonster(nextmonster, 1, board)
  savegame(board)
}

