    let bosses = ['#REF! Demon', 'Grand Compiler', 'Summatrix', 'Hydraxponent']
    let rares = ['Locked Cell', 'Micro Golem', 'Crazed Clip']
    let egg = ['egg']
    if (normals.includes(monster)) {return(this.getvalue(499+normals.indexOf(monster), 30))}
    if (minibosses.includes(monster)) {return(this.getvalue(499+minibosses.indexOf(monster), 31))}
    if (bosses.includes(monster)) {return(this.getvalue(499+bosses.indexOf(monster), 32))}
    if (rares.includes(monster)) {return(this.getvalue(499+rares.indexOf(monster), 33))}
    if (egg.includes(monster)) {return(this.getvalue(499+egg.indexOf(monster), 34))}
  }

