    [['...', 1], ["Oh! Didn't see you there Rowgue", 1], ['I hope you can utilize that stealth', 0]],

    [['That is some bulky armor Macroknight', 1], ['I hope it lets you last', 0]],

    [['Cool robes Stackleric', 1], ['I hope you can outlast them', 0]],

    [["Don't weaken me Auditshade", 1], ['I hope you can weaken them all', 0]],

    [["That's a big book Hyperlinker", 1], ['I hope you can fill it to the brim', 0]],

    [['Woah!', 1], ['Heh, I thought you were a #REF! Demon', 2], ['I hope you can manage that flickering', 0]]
