    ['CHOOSE', 'RARITY: Script, TYPE: Support, EFFECT: Reroll all of the displayed rewards after clearing a wave', 5]
  ]
  let programspelllist = [
    ['NOW', "RARITY: PROGRAM, TYPE: Support, EFFECT: Quadruple your ATK, DEF, MAG, and LUCK for 1 turn, if the enemy is not defeated when the buff runs out you take 75% of your current HP as damage", 3],
    ['TIME', 'RARITY: PROGRAM, TYPE: Support, POWER: N/A, EFFECT: Freezes the enemy for 3 turns including the turn it was cast, making them unable to act (unaffected by DURATION)', 3],
    ['ISBLANK', 'RARITY: PROGRAM, TYPE: Standard, POWER: N/A, EFFECT: Instantly defeat a non-boss enemy', 1],
    ['IMAGINARY', 'RARITY: PROGRAM, TYPE: Support, POWER: N/A, EFFECT: Add 5 spell charges to all other spells in your spellbook', 1],
    ['FISHER', 'RARITY: PROGRAM, TYPE: Support, POWER: N/A, EFFECT: Reroll all of the displayed rewards after clearing a wave without changing their rarities', 10]
  ]
  let singleuselist = [
    ['SMALL', 'EFFECT: Immediately restore 20% of your max HP'], 
    ['LARGE', 'EFFECT: Immediately restore 80% of your max HP'], 
    ['ISEVEN', 'EFFECT: Immediately restore 20% of your max HP, if your current HP is even restore 50% instead'], 
    ['ISODD', 'EFFECT: Immediately restore 20% of your max HP, if your current HP is odd restore 50% instead'], 
    ['RANDBETWEEN', 'EFFECT: Immediately restore a random amount between 0 and the difference between your current and max HP'],
    ['CORREL', 'EFFECT: Immediately gain a shield']
  ]

  //Handle the unlockable starter items
  if (board.iscellblademastered()) {//Cellblade
    macrospelllist.push(['POW', 'RARITY: Macro, TYPE: Standard, POWER: 15, EFFECT: None', board.infinity])
  }
  if (board.issheetmancermastered()) {//Sheetmancer
    macrospelllist.push(['CHAR', 'RARITY: Macro, TYPE: Magic, POWER: 15, EFFECT: None', board.infinity])
  }
  if (board.isrowguemastered()) {//Rowgue
    formulaspelllist.push(['POISSON', 'RARITY: Formula, TYPE: Standard, POWER: 10, EFFECT: Does extra damage upon a critical hit', board.infinity])
    sheetitemlist.push(['PROB', 'RARITY: SHEET, TYPE: Other, EFFECT: Increase ATK and MAG by 20% of your LUCK, this item cannot be disabled by monsters'])
  }
  if (board.ismacroknightmastered()) {//Macroknight
    macrospelllist.push(['EXACT', 'RARITY: Macro, TYPE: Standard, POWER: 10, EFFECT: Combines ATK and DEF to calculate damage', board.infinity])
    tableitemlist.push(['CONFIDENCE', 'RARITY: Table, TYPE: Other, EFFECT: Increase LUCK by 100%, then convert it all into HP, this item cannot be disabled by monsters'])
  }
  if (board.isstacklericmastered()) {//Stackleric
    formulaspelllist.push(['PROPER', 'RARITY: Formula, TYPE: Magic, POWER: 10, EFFECT: None', 40])
    scriptspelllist.push(['CLEAN', 'RARITY: Script, TYPE: Support, EFFECT: Restore 25% of your max HP', board.infinity])
    sheetitemlist.push(['RATE', 'RARITY: SHEET, TYPE: Standard, EFFECT: Increase the effectiveness of all heals by 50%, this item cannot be disabled by monsters'])
  }
  if (board.isauditshademastered()) {//Auditshade
    scriptspelllist.push(['RANK', "RARITY: Script, TYPE: Standard, POWER: 15, EFFECT: Increase the power based on how much higher your ATK is compared to the enemy's ATK", board.infinity], ['INTERCEPT', "RARITY: Script, TYPE: Support, EFFECT: Permanently reduce the enemy's ATK and DEF by 30%", 20])
    sheetitemlist.push(['QUOTIENT', 'RARITY: SHEET, TYPE: Standard, EFFECT: Decrease enemy ATK the higher your MAG is, this item cannot be disabled by monsters'])
  }
  if (board.ishyperlinkermastered()) {//Hyperlinker
    programspelllist.push(['SUBTOTAL', 'RARITY: PROGRAM, TYPE: Standard, POWER: ???, EFFECT: The power is determined by the total number of items you have, and less so by the total number of charges in your spellbook ('+board.infinity+' is treated as 20 charges)', board.infinity])
  }

  //Detect the presence of certain items
  let items = detectitems(['DAY', 'WEEK', 'MONTH', 'SIN', 'COS'], board)
  let day = items[0]
  let week = items[1]
  let month = items[2]
  let sin = items[3]
  let cos = items[4]

  //Handle the items
  //Add WEEK if you have 7 DAY
  if (day==7) {rangeitemlist.push(['WEEK', 'RARITY: Range, MAX: 4, TYPE: Other, EFFECT: Week after week...'])}

  //Add MONTH if you have 7 DAY and 4 WEEK
  if (week==4 && day==7) {tableitemlist.push(['MONTH', 'RARITY: Table, MAX: 12, TYPE: Other, EFFECT: Month after month...'])}

  //Add the YEAR version that doesn't require DAY, WEEK, or MONTH if it is unlocked
  if (board.iserrormastered()) {sheetitemlist.push(['YEAR', 'RARITY: SHEET, TYPE: Standard, EFFECT: Finally! Increase all stats by 100%'])}

  //Otherwise add the version of YEAR that does require DAY, WEEK, and MONTH if you have 7 DAY, 4 WEEK, and 12 MONTH
  else if (month==12 && week==4 && day==7) {sheetitemlist.push(['YEAR', 'RARITY: SHEET, TYPE: Standard, EFFECT: Finally! Increase all stats by 100% while you have 7 DAY, 4 WEEK, and 12 MONTH'])}

  //Add TAN if you have SIN and COS
  if ((sin>0 && cos>0) || board.iserrormastered()) {programspelllist.push(['TAN', 'RARITY: PROGRAM, TYPE: Magic, POWER: 50, EFFECT: Increase the power by 50 for each pair of SIN and COS you have past the first', 10])}

  //Compile all of the smaller lists into one big list
  return([cellitemlist, rangeitemlist, tableitemlist, sheetitemlist, formulaspelllist, macrospelllist, scriptspelllist, programspelllist, singleuselist])
}

