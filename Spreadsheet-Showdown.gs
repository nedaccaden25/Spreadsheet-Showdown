    chosenconvo = [['Something feels different...', 2], ['Did you do it?', 1], ['I can see it on your face', 1], ['You really did it...', 2], ['But then why...', 1], ['Why are we still here?', 2], ['You beat him...', 1], ['You made it out...', 1], ['And yet here we are again', 2], ["Well in any case, it looks like you're trying again", 2], ['Good luck...', 0]]
