function logbook(row, col, board) {
  Logger.log('logbook, 102')
  //This is the code for Alex's logbook

  //If the Return to Title button was selected
  if (row==0 && col==0) {gototitle(board)}

  //If the left arrow was selected
  else if (row==10 && col==6) {
    if (board.getcolor(10, 6)!='#999999') {getlogbookpage(board.getvalue(0, 38)-1, board)}
  }

  //If the right arrow was selected
  else if (row==10 && col==30) {
    if (board.getcolor(10, 30)!='#999999') {getlogbookpage(board.getvalue(0, 38)+1, board)}
  }

  //If the Select Page button was selected
  else if (row==2 && col==36) {
    let page = Browser.inputBox('What page do you want to see?', "Input either a page number or a monster's name", Browser.Buttons.OK_CANCEL)
    if (page!='cancel') {getlogbookpage(page, board)}
  }

  //If the enemy's name was selected
  else if (row==0 && col==12) {Browser.msgBox('This is the '+board.getvalue(0, 12)+"'s logbook page", "Here you can see its base stats, its behaviors (select a blue behavior to see the corresponding animation), and Alex's thoughts on the creature (granted you have defeated enough of them)", Browser.Buttons.OK)}

  //If the enemy's HP was selected
  else if (row==2 && col>=12 && col<=14) {Browser.msgBox('This is the '+board.getvalue(0, 12)+"'s base HP stat", 'This is how much HP the '+board.getvalue(0, 12)+' would have if it appeared on wave 1 with no other modifiers', Browser.Buttons.OK)}

  //If the enemy's ATK was selected
  else if (row==2 && col>=18 && col<=20) {Browser.msgBox('This is the '+board.getvalue(0, 12)+"'s base ATK stat", 'This is how much ATK the '+board.getvalue(0, 12)+' would have if it appeared on wave 1 with no other modifiers', Browser.Buttons.OK)}

  //If the enemy's DEF was selected
  else if (row==2 && col>=23 && col<=25) {Browser.msgBox('This is the '+board.getvalue(0, 12)+"'s base DEF stat", 'This is how much DEF the '+board.getvalue(0, 12)+' would have if it appeared on wave 1 with no other modifiers', Browser.Buttons.OK)}

  //If the kill count was selected
  else if (row==20 && col>=28 && col<=33) {Browser.msgBox("This is how many times you've defeated a "+board.getvalue(0, 12), "This counts every time you've defeated a "+board.getvalue(0, 12)+" across all of your runs. Defeat enough of them to reveal more of Alex's notes", Browser.Buttons.OK)}

  //If Alex's notes section was selected
  else if (row>=22 && row<=30 && col==0) {Browser.msgBox("These are Alex's notes on the "+board.getvalue(0, 12), "These notes describe Alex's theories and encounters with the "+board.getvalue(0, 12)+'. Defeat enough of them to see all the notes', Browser.Buttons.OK)}

  //If a behavior was selected
  else if (row>=22 && row<=30 && col==20) {
    animatelogbookmonster(row-22, board.getvalue(0, 12), board)
  }

  //If nothing in particular was selected
  else if (row<=30) {
    Browser.msgBox("This is Alex's logbook", "Here you can see each monster you've defeated along with their base stats, their behaviors, and Alex's own personal notes on them", Browser.Buttons.OK)
  }
}

function game(row, col, board) {
  Logger.log("game, 154")
  //This is the bulk of the code, as this is what runs during actual gameplay

  //Check if you are dead, if you are, return immediately to the title screen
  //This is done because you shouldn't be able to hit the select button if you're dead since the pop-up that appears when you die should take you back to the title screen regardless of what happens
  if (board.getplayercurrenthp()==0) {gototitle(board); return}

  //First thing's first, what was selected?
  let selected = whatwasselected(row, col, board)
  
  //Now call functions depending on what was selected
  //If you selected a spell...
  if (selected[0] == 'spell') {

    //Figure out what the player wants to do with this spell
    let whatdowithspell = askaboutspell(selected[1], board)

    //If the spell was cast
    if (whatdowithspell=='cast') {

      //Do the entire turn
      //Returns either, where -1 is prioritized over 1 since if you both died, the run should still end
      //0: nothing died
      //1: enemy died
      //-1: player died
      let isdead = doturn(selected[1], board)

      //If the enemy was killed, display the death message and get exp (also reset the NOW buff)
      if (isdead==1) {defeatenemy(board)}

      //If you were killed, display the death message
      if (isdead==-1) {
        //Wait for a second and a half to really let it sink in
        board.pause(1.5)

        //Update your save data to let you return to the start of the wave
        returntowavestart(board)

        //Display the death message
        Browser.msgBox('You Died!', "You were killed by the "+board.getenemyname()+" on wave "+board.getwavecount()+". Better luck next time!"+"\\n"+"(You may continue playing on this file, but you will earn significantly less Bits and Chips)", Browser.Buttons.OK)

        //Then display the title screen
        gototitle(board)
      }
    }

    if (whatdowithspell=='remove') {
      removespell(selected[1], 'yes', board)
    }
  }

  //If you selected a reward...
  else if (selected[0]=='reward') {
    //Do nothing if no reward was actually selected or if the reward is empty
    if (selected[1]==-1 || board.getrewardheader(selected[1])=='') {return}

    //Display a helper message if the reward is black
    if (board.getrewardcolor(selected[1])=='#000000') {
      Browser.msgBox('This reward has already been claimed', '', Browser.Buttons.OK)
      return
    }

    //Get the reward's information ([header, name, desc, color])
    let reward = board.getreward(selected[1])

    //Collect the reward, exiting the function immediately if the reward cannot be collected
    if (collectreward(reward, 'reward', board)==0) {return}

    //Check for unlocks
    if (reward[1]=='YEAR' && !board.isstacklericunlocked()) {
      board.unlockstackleric()
      Browser.msgBox('You unlocked the Stackleric class!', 'By obtaining YEAR, you unlocked the Stackleric class to try out in future runs!', Browser.Buttons.OK)
    }

    //Turn the reward black
    board.setrewardcolor(selected[1], '#000000')

    //Decrement the number of rewards that can be taken
    board.setchoicesleft(board.getchoicesleft()-1)

    //Wait for a split second
    board.pause(0.3)

    //If there are no more choices left, start the next wave
    if (board.getchoicesleft()==0) {startnewwave(board)}
  }

  //If you chose to skip the rewards
  else if (selected[0] == 'skip rewards') {
    let yesno = Browser.msgBox('Skip the rewards?', "Are you sure you don't want to take any of these rewards?", Browser.Buttons.YES_NO)
    if (yesno=='yes') {startnewwave(board)}
  }

  //If you selected the amount of choices you have left
  else if (selected[0] == 'choices left') {
    Browser.msgBox('This is how many rewards you can claim', 'After claiming this many rewards, you will advance to the next wave', Browser.Buttons.OK)
  }

  //If you selected an item in the shop
  else if (selected[0] == 'shop item') {
    //Do nothing if no shop item was selected
    if (selected[1]==-1) {return}

    //Display a helper message if the shop item is black
    if (board.getshopitemcolor(selected[1])=='#000000') {
      Browser.msgBox('This shop item has already been purchased', '', Browser.Buttons.OK)
      return
    }

    //Get the shop item's information ([header, name, desc, color, cost, currency])
    let shopitem = board.getshopitem(selected[1])

    //Ask to make sure the player wants to purchase this item
    let currency = 'Bits'; if (shopitem[5]==board.chipicon) {currency = 'Chips'}
    if (Browser.msgBox('Purchase '+shopitem[1]+'?', 'Do you want to purchase '+shopitem[1]+' for '+shopitem[4]+' '+currency+'?', Browser.Buttons.YES_NO)!='yes') {return}

    //Collect the shop item, exiting the function immediately if the shop item cannot be collected
    if (collectreward(shopitem, 'shop item', board)==0) {return}

    //Check for unlocks
    if (shopitem[1]=='YEAR' && !board.isstacklericunlocked()) {
      board.unlockstackleric()
      Browser.msgBox('You unlocked the Stackleric class!', 'By obtaining YEAR, you unlocked the Stackleric class to try out in future runs!', Browser.Buttons.OK)
    }

    //Turn the shop item black
    board.setshopitemcolor(selected[1], '#000000')
  }

  //If you chose to leave the shop
  else if (selected[0]=='leave shop') {
    let yesno = Browser.msgBox('Leave the shop?', '', Browser.Buttons.YES_NO)
    if (yesno=='yes') {startnewwave(board)}
  }

  //If you selected the refresh shop button
  else if (selected[0]=='refresh shop') {
    let yesno = Browser.msgBox('Refresh the shop?', 'You can pay '+board.getchoicesleft()+' to refresh the unclaimed offers.', Browser.Buttons.YES_NO)
    if (yesno=='yes') {
      if (!board.removebits(board.getchoicesleft().slice(0, board.getchoicesleft().length-1))) {
        Browser.msgBox('Not enough Bits', 'You do not have enough Bits to refresh the shop', Browser.Buttons.OK); return
      }
      for (let i=0; i<=6; i++) {
        if (board.getshopitemcolor(i)!='#000000') {
          generateshopitem(i, board)
        }
      }
      board.setchoicesleft(board.getchoicesleft().slice(0, board.getchoicesleft().length-1)*2+board.biticon)
    }
  }

  //If you selected the enemy's sprite
  else if (selected[0] == 'enemy picture') {
    Browser.msgBox('This is the current enemy', 'Defeat this enemy to get a reward and advance to the next wave', Browser.Buttons.OK)
  }

  //If you selected an item...
  else if (selected[0] == 'item') {
    //Is this item slot empty?
    if (board.getitemname(selected[1])=='') {
      Browser.msgBox('This is an empty Item Slot', 'This Item Slot has nothing in it, if you find an item later you can put any number of that item in that spot', Browser.Buttons.OK)
      return
    }

    //Gather any helper text that this item should display (TODO make this its own function and add the rest of the items and account for having multiple stacks in the descriptions)
    
    let helpertext = ''
    //IFS
    if (board.getitemname(selected[1])=='IFS') {
      helpertext = helpertext+'IFS is currently boosting:'+'\\n'+'\\n'
      if (detectitems(['IF'], board)[0]>0) {helpertext = helpertext+'MAG: +'+3*detectitems(['IF'], board)[0]+'%'+'\\n'}
      else {helpertext = helpertext+'Nothing'+'\\n'}
      helpertext = helpertext+'\\n'
    }
    //RAND
    if (board.getitemname(selected[1])=='RAND') {
      helpertext = helpertext+'RAND is currently boosting:'+'\\n'+'\\n'
      if (board.getrandhpboost()>0) {helpertext = helpertext+'HP: +'+15*board.getrandhpboost()+'%'+'\\n'}
      if (board.getrandatkboost()>0) {helpertext = helpertext+'ATK: +'+15*board.getrandatkboost()+'%'+'\\n'}
      if (board.getranddefboost()>0) {helpertext = helpertext+'DEF: +'+15*board.getranddefboost()+'%'+'\\n'}
      if (board.getrandmagboost()>0) {helpertext = helpertext+'MAG: +'+15*board.getrandmagboost()+'%'+'\\n'}
      if (board.getrandluckboost()>0) {helpertext = helpertext+'LUCK: +'+15*board.getrandluckboost()+'%'+'\\n'}
      if (board.getrandhpboost()+board.getrandatkboost()+board.getranddefboost()+board.getrandmagboost()+board.getrandluckboost()==0) {helpertext = helpertext+'Nothing'+'\\n'}
      helpertext = helpertext+'\\n'
    }
    //DELTA
    if (board.getitemname(selected[1])=='DELTA') {
      helpertext = helpertext+'DELTA is currently boosting:'+'\\n'+'\\n'
      if (board.getdeltaboost()>0) {helpertext = helpertext+'ATK & MAG: +'+30*board.getdeltaboost()+'%'+'\\n'}
      else {helpertext = helpertext+'Nothing'+'\\n'}
      helpertext = helpertext+'\\n'
    }
    //IFERROR
    if (board.getitemname(selected[1])=='IFERROR') {
      helpertext = helpertext+'IFERROR is currently boosting:'+'\\n'+'\\n'
      if (detectitems(['IF'], board)+detectitems(['IFS'], board)==0) {helpertext = helpertext+'MAG: +'+75*board.getitemquantity(selected[1])+'%'+'\\n'}
      else {helpertext = helpertext+'Nothing'+'\\n'}
      helpertext = helpertext+'\\n'
    }
    //INDEX
    if (board.getitemname(selected[1])=='INDEX') {
      helpertext = "WARNING: Removing INDEX from your inventory right now won't do anything!"+'\\n'+'You must remove INDEX when selecting rewards after a wave to get the effects'
      if (board.getenemyname()=='Rewards:') {
        helpertext = 'Removing INDEX from your inventory will give you one extra reward choice for these current rewards per INDEX you remove'
      }
      helpertext = helpertext+'\\n'+'\\n'+'\\n'
    }
    //COUNT
    if (board.getitemname(selected[1])=='COUNT') {
      helpertext = helpertext+'COUNT is currently increasing HP by:'+Math.ceil(board.getnumberofitems())+'\\n'+'\\n'+'\\n'
    }

    //Ask if this item is to be removed
    let toremove = Browser.inputBox('Remove '+board.getitemname(selected[1])+' from your inventory?', helpertext+'Type the number you want to remove, or you can type "all" to remove all stacks of the item', Browser.Buttons.OK_CANCEL)
    if ((toremove>0 && toremove.toUpperCase!='CANCEL') || toremove.toUpperCase()=='ALL') {
      removeitem(toremove.toUpperCase(), selected[1], board)

      //Recalculate stats with new item loadout
      recalculatestats(0, board)
    }
  }

  //If you selected the Inventory header...
  else if (selected[0]=='inventory') {
    Browser.msgBox('This is your Inventory', 'Items you find will get stored here. Be warned however, you can only hold 18 different items at a time. Items can be removed from your inventory at any time by selecting them. Manage your limited inventory space to succeed.', Browser.Buttons.OK)
  }

  //If you selected the Spellbook header...
  else if (selected[0]=='spellbook') {
    Browser.msgBox('This is your Spellbook', 'Spells you find will get stored here. Keep in mind that you only have a limited number of spell slots (6 to start). Spells can be cast when you are fighting enemies, but they can also be removed at any time by selecting them and choosing not to cast them. Casting spells uses up their charges, and when a spell is out of charges it will be removed from your spellbook. Manage your limited spell slots and spell charges to succeed.', Browser.Buttons.OK)
  }

  //If you selected the turn counter...
  else if (selected[0]=='turns') {
    Browser.msgBox('This is the turn counter', 'This displays how many turns have passed in your current wave. Some spells and enemies may behave differently based on the turn count.', Browser.Buttons.OK)
  }

  //If you selected the wave counter...
  else if (selected[0]=='waves') {
    Browser.msgBox('This is the wave counter', 'This displays how many waves have passed in your current run. Be careful though, the enemies you find will get stronger and stronger as you get to later waves.', Browser.Buttons.OK)
  }

  //If you selected your Bits...
  else if (selected[0]=='bits') {
    Browser.msgBox('These are your Bits', 'Bits are fairly common and can be used in the shop or for Conditional Formatting', Browser.Buttons.OK)
  }

  //If you selected your Chips...
  else if (selected[0]=='chips') {
    Browser.msgBox('These are your Chips', 'Chips are quite rare and can be used in the shop or for Conditional Formatting', Browser.Buttons.OK)
  }

  //If you selected the exit button...
  else if (selected[0]=='exit') {
    let yesno = Browser.msgBox('Return to title screen?', 'All data has been saved.', Browser.Buttons.YES_NO)

    if (yesno=='yes') {
      gototitle(board)
    }
  }

  //If you selected the difficulty banner...
  else if (selected[0]=='difficulty') {
    let difficulties = ['Intern', 'Associate', 'Manager', 'Executive', 'CEO']
    let helpertexts = [
      "You're just here to learn... And maybe to have some coffee"+'\\n'+'Effects:'+'\\n'+'Decreased enemy scaling speed'+'\\n'+'Full heal on level-up',

      'You know how to format cells and maybe survive a few meetings'+'\\n'+'Effects:'+'\\n'+'None',

      "Now you're responsible for others' mistakes"+'\\n'+'Effects:'+'\\n'+'Increased enemy scaling speed',

      "You're always busy, always blamed, and always behind"+'\\n'+'Effects:'+'\\n'+'Insane enemy scaling speed'+'\\n'+'All enemies have slightly increased ATK',

      "Automation isn't coming for your job, you are the automation"+'\\n'+'Effects:'+'\\n'+'Ridiculous enemy scaling speed'+'\\n'+'All enemies have moderately increased ATK and DEF'+'\\n'+'All enemies give reduced exp'+'\\n'+'Reduced effectiveness of luck'
    ]
    let text = helpertexts[difficulties.indexOf(board.getcurrentdifficulty())]
    Browser.msgBox(board.getcurrentdifficulty(), text, Browser.Buttons.OK)
  }

  //If you selected the enemy's HP...
  else if (selected[0]=='enemyhp') {
    Browser.msgBox("This is the enemy's HP", "When the enemy's HP is reduced to 0 you have successfully beaten this wave and will get to choose a reward", Browser.Buttons.OK)
  }

  //If you selected the enemy's ATK...
  else if (selected[0]=='enemyatk') {
    Browser.msgBox("This is the enemy's ATK", 'The enemy uses this stat on its turn when it attacks you to determine how much damage it deals', Browser.Buttons.OK)
  }

  //If you selected the enemy's DEF...
  else if (selected[0]=='enemydef') {
    Browser.msgBox("This is the enemy's DEF", 'When you attack the enemy, the damage you deal will get reduced relative to this stat', Browser.Buttons.OK)
  }

  //If you selected an enemy name or "Rewards:" or "Shop"...
