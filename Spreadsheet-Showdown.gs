  }

  //Then check if this is the second convo since beating the game and you don't have the logbook unlocked
  else if (board.getwincount()>0 && board.getvalue(499, 19)==0) {
    board.setvalue(499, 19, 1)
    chosenconvo = chronologicalconvos[7]
  }

  //Then check if this is your first convo while playing as Error
  else if (board.getcurrentcharacter()=='Error' && board.getvalue(500, 19)==0) {
    board.setvalue(500, 19, 1)
    chosenconvo = [['Woah!', 1], ['Are you... Okay?', 2], ["You're like...", 1], ['Flickering...', 1], ['Well I hope you can manage that...', 0]]
  }

  //Then check if there are stil chrono convos to do
  else if (board.getalexcount()<chronologicalconvos.length) {
    //If you already have the logbook, skip #7
    if (board.getalexcount()==7 && board.getvalue(499, 19)==1) {board.incalexcount()}

    chosenconvo = chronologicalconvos[board.getalexcount()]
    board.incalexcount()
  }

  //Finally, if there were no other convos to do, choose a random one
  else {
    chosenconvo = randomconvos[Math.floor(Math.random()*randomconvos.length)]
  }

  //Now go through the conversation sentence by sentence
  let name = '???: '
  if (board.getvalue(502, 19)==1) {name = 'Alex: '}
  for (let i=0; i<chosenconvo.length; i++) {
    if (i==3 && board.getalexcount()==4) {name = 'Alex: '}
    text(name+chosenconvo[i][0], chosenconvo[i][1], 'Alex', board)
  }

  //Wait 2 seconds before loading the shop
  board.pause(2)
}

function generaterewarditem(index, board) {
  Logger.log("generaterewarditem, 2922")
  //Get your LUCK, since it's used a lot here
  let luck = board.getplayerluck()

  //Halve your luck if playing on CEO difficulty
  if (board.getcurrentdifficulty()=='CEO') {luck=Math.floor(luck/2)}

  //Get every possible reward
  let list = getlistofrewards(board)

  //Make a list of the different colors that correspond to the rarities
  let colors = ['#cccccc', '#a4c2f4', '#93c47d', '#8e7cc3', '#ffd966', '#e69138', '#e06666', '#c27ba0', '#ffffff']

  //Detect the presence of certain items
  let items = detectitems(['COMPLEX'], board)
  let complex = items[0]

  //Figure out the odds between items and spells
  //Chance of spell  = 0.2(e^(-0.005*luck))+0.4*(1-e^(-0.005*luck))      20% -> 40% as luck increases
  let spellcutoff = .2*Math.pow(Math.E, -0.005*luck)+0.4*(1-Math.pow(Math.E, -0.005*luck))

  //Use a random number to determine if this choice will be an item, spell, or single-use (0->item, 4->spell, 8->single-use)
  let type = 0
  if (index==0) {type = 8}
  else if (Math.random()<=spellcutoff) {type = 4}
  
  //Initialize the variables that store the item details
  let item
  let desc
  let charges
  let rare = 0

  //Handle picking the item if it is a spell or item, since those are handled very similarly
  if (type!=8) {
    //Figure out the odds for the different rarities
    //commonweight    = 0.75(e^(-0.005*luck))+0.3(1-e^(-0.005*luck))     75% -> 30% as luck increases
    //uncommonweight  = 0.2(e^(-0.005*luck))+0.3(1-e^(-0.005*luck))      19% -> 30% as luck increases
    //rareweight      = 0.3(1-e^(-0.005*luck))                           5% -> 30% as luck increases
    //legendaryweight = 0.3(1-e^(-0.005*luck))                           1% -> 10% as luck increases
    let commonweight = 0.75*Math.pow(Math.E, -0.005*luck)+0.3*(1-Math.pow(Math.E, -0.005*luck))
    let uncommonweight = 0.19*Math.pow(Math.E, -0.005*luck)+0.3*(1-Math.pow(Math.E, -0.005*luck))
    let rareweight = 0.05*Math.pow(Math.E, -0.005*luck)+0.3*(1-Math.pow(Math.E, -0.005*luck))
    let legendaryweight = 0.01*Math.pow(Math.E, -0.005*luck)+0.1*(1-Math.pow(Math.E, -0.005*luck))  //Unused, but it's here for reference

    //Determine the rarity of this choice
    let r = Math.random()                                    //Doing nothing is Common
    if (r>commonweight+uncommonweight+rareweight) {rare = 3} //Legendary
    else if (r>commonweight+uncommonweight) {rare = 2}       //Rare
    else if (r>commonweight) {rare = 1}                      //Uncommon

    //Use the type and rarity to index into the array to get what choice this is
    r = Math.floor(Math.random()*(list[type+rare].length))
    item = list[type+rare][r][0]
    desc = list[type+rare][r][1]
    if (type==4) {
      charges = list[type+rare][r][2]
      if (charges!=board.infinity) {charges = charges+Math.ceil(charges*complex*0.2)}
    }

  //Handle picking the single-use item
  } else {
    //Figure out the odds between getting the SMALL and LARGE items
    //Chance of LARGE  = 0.05(e^(-0.005*luck))+0.4(1-e^(-0.005*luck))    5% -> 40% as luck increases
    let smallcutoff = 0.95*Math.pow(Math.E, -0.005*luck)+0.6*(1-Math.pow(Math.E, -0.005*luck))

    //Determine exactly what single-use item should be selected
    let r = Math.random()
    let index = 1                       //LARGE
    if (r<0.15) {index=2}               //ISEVEN
    else if (r<0.3) {index=3}           //ISODD
    else if (r<0.45) {index=4}          //RANDBETWEEN
    else if (r<0.6) {index=5}           //CORREL
    else if (r<smallcutoff) {index=0}   //SMALL

    //Get the necessary information using that index
    item = list[type][index][0]
    desc = list[type][index][1]
  }

  //Fill the box with the item chosen
  if (type==0) {
    board.setreward(index, 'Item:', item, desc, colors[type+rare])
  } else if (type==4) {
    board.setreward(index, 'Spell:', item+'('+charges+')', desc, colors[type+rare])
  } else {
    board.setreward(index, 'Single-Use:', item, desc, colors[type+rare])
  }
}

function generateshopitem(index, board) {
  Logger.log('generateshopitem, 3011')

  //Get every possible shop item
  let list = getlistofrewards(board)
  
  //Make a list of the different colors that correspond to the rarities
  let colors = ['#cccccc', '#a4c2f4', '#93c47d', '#8e7cc3', '#ffd966', '#e69138', '#e06666', '#c27ba0', '#ffffff']

  //Detect the presence of certain items
  let items = detectitems(['COMPLEX'], board)
  let complex = items[0]

  //Translate the shop index into an index corresponding to the correct item/spell rarity
  //index = 0: Single-Use
  //1: Range Item
  //2: Table Item
  //3: SHEET Item (Table Item on wave 25)
  //4: Macro Spell
  //5: Script Spell
  //6: PROGRAM Spell (Script Spell on wave 25)
  let translateindex = [8,1,2,3,5,6,7]
  let type = translateindex[index]
  if ((type==3 || type==7) && board.getwavecount()==25) {type--}

  //Get a random element from the chosen list
  let r = Math.floor(Math.random()*list[type].length)
  let item = list[type][r][0]
  let desc = list[type][r][1]
  let charges = 0
  if (type>3 && type!=8) {
    charges = list[type][r][2]
    if (charges!=board.infinity) {charges = charges+Math.ceil(charges*complex*0.2)}
  }
  let costlist = [5, 12, 25, 1, 7, 20, 40, 3, 8]
  let currencylist = [board.biticon, board.biticon, board.biticon, board.chipicon, board.biticon, board.biticon, board.biticon, board.chipicon, board.biticon]
  let cost = [costlist[type], currencylist[type]]

  //Convert the base cost into the actual cost depending on wave count and difficulty
  let difficultymodifier = [1, 0.6]
  if (board.getcurrentdifficulty()=='Associate') {difficultymodifier = [1.5, 0.65]}
  else if (board.getcurrentdifficulty()=='Manager') {difficultymodifier = [2, 0.7]}
  else if (board.getcurrentdifficulty()=='Executive') {difficultymodifier = [2.5, 0.75]}
  else if (board.getcurrentdifficulty()=='CEO') {difficultymodifier = [3, 0.85]}
  //cost = floor(basecost*diffmod2*shop#^(diffmod1*(1+basecost/1000)))
  cost[0] = Math.floor(cost[0]*difficultymodifier[1]*Math.pow(board.getwavecount()/25, difficultymodifier[0]+(1+cost[0]/1000)))

  //Fill the box with the item chosen
  if (type==8) {
    board.setshopitem(index, 'Single-Use:', item, desc, colors[type], cost[0], cost[1])
  } else if (type<4) {
    board.setshopitem(index, 'Item:', item, desc, colors[type], cost[0], cost[1])
  } else {
    board.setshopitem(index, 'Spell:', item+'('+charges+')', desc, colors[type], cost[0], cost[1])
  }
}

function removespell(index, displaybox, board) {
  Logger.log("removespell, 3068")
  //First check to make sure that this isn't the player's last spell
  if (board.getnumberofspells()==1) {
    if (displaybox=='yes') {Browser.msgBox('You cannot remove your only spell', '', Browser.Buttons.OK)}
    return
  }

  //Copy the spells below the selected one up until the bottom of the Spellbook is reached
  while (true) {
    if (board.getspellcolor(index+1)=='#ddbc9a') {
      let nextspell = board.getspell(index+1)
      board.setspell(index, nextspell[0], nextspell[1], nextspell[2], nextspell[3])
      index=index+1
    } else {
      board.setspell(index, '', '', '')
      break
    }
  }
}

function removeitem(toremove, index, board) {
  Logger.log("removeitem, 3089")

  if (toremove=='ALL' || toremove>=board.getitemquantity(index)) {
    //If INDEX was removed on the rewards screen, add reward choices
    if (board.getenemyname()=='Rewards:' && board.getitemname(index)=='INDEX') {
      board.setchoicesleft(Number(board.getchoicesleft())+Number(board.getitemquantity(index)))
    }
    //Copy the items below the selected one up until the bottom of the inventory is reached
    let nextitem
    while (index<20) {
      if (board.getitemname(index+1)!='') {
        nextitem = board.getitem(index+1)
        board.setitem(index, nextitem[0], nextitem[1], nextitem[2], nextitem[3])
        index++
      } else {
        board.setitem(index, '', '', '', '#d9d9d9')
        break
      }
    }
    //Remove the last element, since there will never be one after this operation
    board.setitem(20, '', '', '', '#d9d9d9')
  } else {
    //If INDEX was removed on the rewards screen, add reward choices
    if (board.getenemyname()=='Rewards:' && board.getitemname(index)=='INDEX') {
      board.setchoicesleft(Number(board.getchoicesleft())+Number(toremove))
    }
    board.setitemquantity(index, board.getitemquantity(index)-toremove)
  }
}

function collectreward(reward, type, board) {//reward: [header, name, desc, color], shop item: [header, name, desc, color, cost, currency]
  Logger.log("collectreward, 3112")
  //Separate further into which reward type
  if (reward[0]=='Single-Use:') {
    //Subtract the cost if purchased from the shop
    if (type=='shop item') {
      if (reward[5]==board.biticon) {
        if (!board.removebits(reward[4])) {
          Browser.msgBox('Not enough Bits', 'You do not have enough Bits to afford the '+reward[1], Browser.Buttons.OK)
          return(0)
        }
      } else if (!board.removechips(reward[4])) {
        Browser.msgBox('Not enough Chips', 'You do not have enough Chips to afford the '+reward[1], Browser.Buttons.OK)
        return(0)
      }
    }
    claimsingle(reward[1], board)
  }

  if (reward[0]=='Item:') {
    //Get how many of that item you already have
    let items = detectitems([reward[1]], board)
    let quantity = items[0]

    //If there is space or if you already have the item, add the item
    if (board.getnumberofitemrows()!=20 || quantity>0) {

      //Also check to see if the selected item is at its max stacks (This is read directly from the description to make it easier to change them)
      let maxstartindex = reward[2].indexOf('MAX: ')+5
      let maxendindex = reward[2].substring(maxstartindex).indexOf(',')+maxstartindex
      let maxquantity = reward[2].substring(maxstartindex, maxendindex)
      if (quantity!=maxquantity) {
        //Subtract the cost if purchased from the shop
        if (type=='shop item') {
          if (reward[5]==board.biticon) {
            if (!board.removebits(reward[4])) {
              Browser.msgBox('Not enough Bits', 'You do not have enough Bits to afford the '+reward[1], Browser.Buttons.OK)
              return(0)
            }
          } else if (!board.removechips(reward[4])) {
            Browser.msgBox('Not enough Chips', 'You do not have enough Chips to afford the '+reward[1], Browser.Buttons.OK)
            return(0)
          }
        }
        claimitem(reward[1], reward[2], board)
      } else {
        Browser.msgBox('Cannot select '+reward[1], reward[1]+' is at its max capacity and no more of it can be collected', Browser.Buttons.OK)
        return(0)
      }
    } else {
      Browser.msgBox('Inventory full', 'You cannot take another item unless you remove a different one from your inventory', Browser.Buttons.OK)
      return(0)
    }
  }

  if (reward[0]=='Spell:') {
    //Detect the presence of certain items
    let items = detectitems(['JOIN'], board)
    let join = items[0]

    //If there is a space for a new spell in your spellbook, add the spell
    if (board.getnumberofspells()!=6+join) {
      //Subtract the cost if purchased from the shop
      if (type=='shop item') {
        if (reward[5]==board.biticon) {
          if (!board.removebits(reward[4])) {
            Browser.msgBox('Not enough Bits', 'You do not have enough Bits to afford the '+reward[1], Browser.Buttons.OK)
            return(0)
          }
        } else if (!board.removechips(reward[4])) {
          Browser.msgBox('Not enough Chips', 'You do not have enough Chips to afford the '+reward[1], Browser.Buttons.OK)
          return(0)
        }
      }
      claimspell(reward[1], reward[2], board)
    } else {
      Browser.msgBox('Spellbook full', 'You cannot take another spell unless you remove a different one from your spellbook', Browser.Buttons.OK)
      return(0)
    }
  }

  //Flag that a reward has been successfully chosen
  return(1)
}

function claimsingle(reward, board) {
  Logger.log("claimsingle, 3197")
  //Make a scratch variable for calculations
  let extra

  //Time for another switch case for the single-use items
  switch(reward) {
    case 'SMALL':
      heal(20, 'percent', 'player', 'You used SMALL', board)
      break
    case 'LARGE':
      heal(80, 'percent', 'player', 'You used LARGE', board)
      break
    case 'ISEVEN':
      if (board.getplayercurrenthp()%2==0) {heal(50, 'percent', 'player', 'You used ISEVEN effectively', board)}
      else {heal(20, 'percent', 'player', 'You used ISEVEN ineffectively', board)}
      break
    case 'ISODD':
      if (board.getplayercurrenthp()%2==1) {heal(50, 'percent', 'player', 'You used ISODD effectively', board)}
      else {heal(20, 'percent', 'player', 'You used ISODD ineffectively', board)}
      break
    case 'RANDBETWEEN':
      extra = Math.floor(Math.random()*(board.getplayermaxhp()-board.getplayercurrenthp()+1))
      heal(extra, 'flat', 'player', 'You used RANDBETWEEN', board)
      break
    case 'CORREL':
      board.setplayershield(1)
      text('You used CORREL, it gave you a shield!', 0.2, 0, board)
      board.updateplayerhpbar()
      break
  }
}

function claimitem(reward, desc, board) {
  Logger.log("claimitem, 3227")
  //Determine if the player already has at least one of this item
  let alreadyhave = 0
  let i
  for (i=1; i<=20; i++) {
    //Break out if we find the item we have
    if (board.getitemname(i)==reward) {
      alreadyhave=1
      break
    }
    //Break out if we find a blank space
    if (board.getitemname(i)=='') {
      break
    }
  }

  //Put the item in your inventory
  if (alreadyhave==1) {board.setitemquantity(i, board.getitemquantity(i)+1)}
  else {board.setitem(i, 1, reward, desc)}

  //Recalculate your stats to match this new item
  recalculatestats(0, board)
}

function claimspell(reward, desc, board) {
  Logger.log("claimspell, 3251")
  //Seperate the spell name from the number of Spell Charges
  let spellname = reward.substring(0, reward.indexOf('('))
  let spellcharges = reward.substring(reward.indexOf('(')+1, reward.length-1)

  //Put this spell in the first empty spot
  board.setspell(board.getnumberofspells()+1, spellname, desc, spellcharges)
}

function heal(heal, mode, target, message, board) {
  Logger.log("heal, 3261")
  //Differentiate between the enemy's healing and yours
  if (target!='enemy') {
    //Detect the presence of certain items
    let rate = detectitems(['RATE'], board)[0]

    //Increase healing by 50% per RATE
    if (rate>0) {heal = Math.ceil(heal*(1+0.5*rate))}

    //Convert percentage heals to flat heals
    if (mode=='percent') {heal = Math.ceil(heal*board.getplayermaxhp()/100)}

    //Display the amount healed
    if (message!='') {message = message+', i'} else {message = 'I'}
    text(message+'t healed '+heal.toLocaleString('en-US')+' HP!', 0.2, 0, board)

    //Update the current health
    board.setplayercurrenthp(Math.min(board.getplayercurrenthp()+heal, board.getplayermaxhp()))
    board.updateplayerhpbar()

    //Return the amount healed in case certain behavoirs need it
    return(heal)

  } else {
    //Convert percentage heals to flat heals
    if (mode=='percent') {heal = Math.ceil(heal*board.getenemymaxhp()/100)}

    //Display the amount healed
    if (message!='') {message = message+', i'} else {message = 'I'}
    text(message+'t healed '+heal.toLocaleString('en-US')+' HP!', 0.2, 0, board)

    //Update the current health
    board.setenemycurrenthp(Math.min(board.getenemycurrenthp()+heal, board.getenemymaxhp()))
    board.updateenemyhpbar()

    //Return the amount healed in case certain behavoirs need it
    return(heal)
  }
}

function startnewwave(board) {
  Logger.log("startnewwave, 3287")
  //Reset the formatting of the rewards screen
  board.setmanys(7, 12, 18, 16, [['unmerge'], ['value', ''], ['color', '#ffffff'], ['border', ['no vertical', 'no horizontal']]])

  //Clear any hidden values from last wave
  board.setrandhpboost('')
  board.setrandatkboost('')
  board.setranddefboost('')
  board.setrandmagboost('')
  board.setrandluckboost('')
  board.setdeltaboost('')

  //Clear the display box
  board.cleardisplay()

  //Update wave #
  board.setwavecount(board.getwavecount()+1)

  //Detect the presence of certain items
  let items = detectitems(['RAND', 'DELTA', 'MINUTE'], board)
  let rand = items[0]
  let delta = items[1]
  let minute = items[2]

  //Decrement any buffs that decrease at the end of a wave
  decwavebuffs(board)

  //Reset turn #
  board.setturncount(1)

  //Select a monster based on what wave we are on
  let nextmonster = selectmonster(board.getwavecount(), board.getplayerluck(), board)

  //display the selected enemy's sprite and stats
  displaymonster(nextmonster, board.getwavecount(), board)

  //Handle the items
  if (rand>0) {
    let incs = [0, 0, 0, 0, 0]
    for (let i=0; i<rand; i++) {
      let extra = Math.floor(Math.random()*5)
      incs[extra]++
    }
    board.setrandhpboost(incs[0])
    board.setrandatkboost(incs[1])
    board.setranddefboost(incs[2])
    board.setrandmagboost(incs[3])
    board.setrandluckboost(incs[4])
  }
  if (delta>0 && board.getplayercurrenthp()/board.getplayermaxhp()<=0.5) {
    board.setdeltaboost(delta)
  }
  if (minute>0) {
    let shieldchance = 1-0.05*minute
    if (Math.random()>=shieldchance) {board.setplayershield(1)}
  }

  //Recalculate the stats after handling the items
  recalculatestats(0, board)

  //Save this state to return to if the player dies
  savestartofwave(board)
}

function selectmonster(wave, luck, board) {
  Logger.log("selectmonster, 3349")
  //Halve luck if playing on CEO difficulty
  if (board.getcurrentdifficulty()=='CEO') {luck=Math.floor(luck/2)}

  //Make a list of all of the base monster names
  let monsters = ['Green Sheet Slime', 'Red Sheet Slime', 'Yellow Sheet Slime']
  let minibosses = ['Amalgam Sheet Slime']
  let bosses = ['Grand Compiler', 'Summatrix']
  let raremonsters = ['Locked Cell']
  let egg = ['egg']
  let theboss = ['THE BOSS']
  let listtouse

  //Add monsters depending on wave count
  if (wave>=5) {monsters.push('Cellyfish')}
  if (wave>=10) {monsters.push('Adder', 'Cell Crawler', 'Pensolo')}
  if (wave>=15) {monsters.push('Moni-Troll', 'Subtractarine')}
  if (wave>=20) {minibosses.push('Macro Golem', 'Row Wraith', 'Cellystorm', 'Produconda')}
  if (wave>=50) {minibosses.push('Printentacle', 'Shadow Formula', 'Chartclaw', 'Penseveral', 'Diviling Cabinet')}
  if (wave>=50) {bosses.push('#REF! Demon', 'Hydraxponent')}
  if (wave>=25) {raremonsters.push('Micro Golem')}
  if (wave>=50) {raremonsters.push('Crazed Clip')}

  //Determine what should spawn this round
  if (wave==200) {listtouse=theboss}                                             //Spawn THE BOSS at wave 200
  else if (wave%25==0) {listtouse=bosses}                                        //Spawn a boss every 25 waves
  else if (wave>10 && Math.random()<0.00001*Math.pow(Math.E, -0.005*luck)+0.0001*(1-Math.pow(Math.E, -0.005*luck)))
  {listtouse = egg}                                                              //Stupid rare chance to see the EGG
  else if (wave>10 && Math.random()<0.01*Math.pow(Math.E, -0.005*luck)+0.1*(1-Math.pow(Math.E, -0.005*luck))) {listtouse=raremonsters}                                                       //Spawn rare enemy randomly every non-boss wave after 10
  else if (wave%10==0 || Math.random()*100-50+wave>100) {listtouse=minibosses}   //Spawn a Mini-Boss every 10th wave or randomly after 50
  else {listtouse=monsters}                                                      //Otherwise spawn a normal enemy

  //Return the name of the randomly selected monster
  return(listtouse[Math.floor(Math.random()*listtouse.length)])
}

