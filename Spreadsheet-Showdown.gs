  //Get a list of every enemy in index order (blank space at index 0 to correspond to page # being 1-based)
  let enemies = ['', 'Green Sheet Slime', 'Red Sheet Slime', 'Yellow Sheet Slime', 'Cellyfish', 'Adder', 'Cell Crawler', 'Moni-Troll', 'Subtractarine', 'Pensolo', 'Amalgam Sheet Slime', 'Macro Golem', 'Row Wraith', 'Printentacle', 'Shadow Formula', 'Chartclaw', 'Cellystorm', 'Produconda', 'Penseveral', 'Diviling Cabinet', '#REF! Demon', 'Grand Compiler', 'Summatrix', 'Hydraxponent', 'Locked Cell', 'Micro Golem', 'Crazed Clip', 'egg', 'THE BOSS']

  //If you searched for an enemy by name, correct for slight mispellings for enemies with weird characters
  if (String(page).toUpperCase()=='MONI TROLL' || String(page).toUpperCase()=='MONITROLL') {page = 'Moni-Troll'}
  else if (String(page).toUpperCase()=='#REF DEMON' || String(page).toUpperCase()=='REF! DEMON' || String(page).toUpperCase()=='REF DEMON') {page = '#REF! Demon'}

  //If given a number (>0), index it into the array
  if (parseInt(String(page))!=NaN) {
    if (parseInt(page)>0 && parseInt(page)<enemies.length) {page = enemies[parseInt(page)]}
  }

  //Now convert the name into an index for the other arrays (I know this order is weird)
  //If the given enemy name is not in the list, display an error (doesn't use .includes due to case-sensitivity)
  let flag = 0
  for (let i=0; i<enemies.length; i++) {
    if (enemies[i].toUpperCase()==String(page).toUpperCase()) {page=i; flag=1; break}
  }
  if (flag==0) {Browser.msgBox('Unknown enemy name or bad page number', '', Browser.Buttons.OK); return}

  //Update the page number
  board.setvalue(0, 38, page)
  board.setvalue(499, 18, page)

  //If you have 0 kills against this enemy, replace all the information with mystery info
  if (board.getkillcount(enemies[page])==0) {
    enemies[page] = '???'
    stats[page] = ['???', '???', '???']
    entries[page] = [['???', 0]]
    behaviors[page] = [['???', 'gray']]
  }

