  if (board.getwavecount()!=25) {
    chosenconvo = randomconvos[Math.floor(Math.random()*randomconvos.length)]
  }

  //First check if this is the first convo since beating the game
  else if (board.getwincount()>0 && board.getvalue(501, 19)==0) {
