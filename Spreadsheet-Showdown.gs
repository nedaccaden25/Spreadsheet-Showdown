      else if (grandr==6) {
        //FILTER - +10% to current DEF
        text('The Grand Compiler added a FILTER to its collection!', 0.1, 0, board)
        board.setenemydef(Math.ceil(board.getenemydef()*1.1))
        text("The Grand Compiler's DEF increased by 10%", 0.1, 0, board)
      }
      break
    case 'Summatrix':
      //Has low attack, but every turn adds your amount of items into its attack stat after attacking
      board.drawsprite('Summatrix', 'default0')
      board.setmany(7, 16, [['value', 'a²+b²=c²'], ['fontcolor', '#ffffff']])
      board.setmany(18, 12, [['value', 'logxy=logx+logy'], ['fontcolor', '#ffffff']])
      board.setmany(14, 18, [['value', 'df/dt=lim h->0: (f(t+h)-f(h))/h'], ['fontcolor', '#ffffff']])
      board.setmany(20, 21, [['value', 'e ⷧⁱ+1=0'], ['fontcolor', '#ffffff']])
      board.setmany(24, 18, [['value', 'H=-Σp(x)logp(x)'], ['fontcolor', '#ffffff']])
      board.setmany(10, 13, [['value', 'E=mc²'], ['fontcolor', '#ffffff']])
      board.setmany(11, 22, [['value', 'F=G(m₁m₂/d²)'], ['fontcolor', '#ffffff']])
      board.setmany(17, 21, [['value', 'x=(-b±√b²-4ac)/2a'], ['fontcolor', '#ffffff']])
      dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Summatrix fired equations at you', [], 0.2, board)
      board.setmanys(7, 12, 18, 16, [['value', ''], ['fontcolor', '#000000']])
      board.setenemyatk(board.getenemyatk()+board.getitemquantity(((turn-1)%board.getnumberofitemrows())+1))
      text('The Summatrix summed your '+board.getitemname(((turn-1)%board.getnumberofitemrows())+1)+' into its ATK!', 0.2, 0, board)
      break
    case 'Hydraxponent':
      //Hits once for each head, then slightly raise DEF after attacking depending on # of heads
      board.drawsprite('Hydraxponent', 'attack'+(board.getenemyvar1()-1))
      //If there's only 1 head, do a single normal attack to hide the gimmick
      if (board.getenemyvar1()==1) {
        dealdamage(3, 'default', board.getenemyatk(), board.getenemydef(), 0, 'player', 'The Hydraxponent bit you', [], 0.2, board)
      } else {
        multiattack(3, board.getenemyvar1(), 'default', board.getenemyatk(), board.getenemydef(), 0, 'player', board.getenemyvar1()+' Hydraxponent heads bit you', [], 0.2, board)
      }
      board.drawsprite('Hydraxponent', 'default'+(board.getenemyvar1()-1))
      board.setenemydef(Math.ceil(board.getenemydef()*(1+0.03*board.getenemyvar1())))
      if (board.getenemyvar1()==1) {
        text('The Hydraxponent coiled up, its DEF slightly increased!', 0.2, 0, board)
      } else {
        text('The Hydraxponent coiled up, its DEF slightly increased for each head!', 0.2, 0, board)
      }
      break
    case 'Locked Cell':
      //Does nothing, but flees after 5 turns
      if (turn==1) {
        text('The Locked Cell does nothing', 0.2, 0, board)
      }
      else if (turn==2) {
        text('The Locked Cell still does nothing', 0.2, 0, board)
      }
      else if (turn==3) {
        board.drawsprite('Locked Cell', 'attack0')
        text('The Locked Cell moves a little bit', 0.2, 0, board)
        board.drawsprite('Locked Cell', 'default0')
      }
      else if (turn==4) {
        board.drawsprite('Locked Cell', 'attack1')
        text('The Locked Cell seems to be getting restless...', 0.2, 0, board)
        board.drawsprite('Locked Cell', 'default0')
      }
      else {
        board.drawsprite('Locked Cell', 'attack2')
        text('The Locked Cell flees!', 0.2, 0, board)
        board.drawsprite('Locked Cell', 'attack3')
        board.pause(0.1)
        torewards(false, board)
      }
      break
    case 'Micro Golem':
      if (Math.random()>0.15) {
        board.drawsprite('Micro Golem', 'attack0')
        dealdamage(2, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The panicked Micro Golem swings its tiny arms', [], 0.2, board)
        board.drawsprite('Micro Golem', 'default0')
      } else {
        board.drawsprite('Micro Golem', 'attack1')
        text('The Micro Golem flees!', 0.2, 0, board)
        board.drawsprite('Micro Golem', 'attack2')
        board.pause(0.1)
        torewards(false, board)
      }
      break
    case 'Crazed Clip':
      //Does normal attacks on turns 1 and 2, but if it's not dead by turn 3 it does a strong attack, removes 10 charges from spells, flees
      if (turn>=3) {
        board.drawsprite('Crazed Clip', 'attack1')
        dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Crazed Clip clamps on to you', [], 0.2, board)
        //Remove 10 charges from every spell
        for (let crazedspellnum=board.getnumberofspells(); crazedspellnum!=0; crazedspellnum--) {
          if (board.getspellcharges(crazedspellnum)!='∞') {decrementcharges(crazedspellnum, 'no RANDARRAY', 10, board)}
        }
        text('All spell charges were reduced by 10!', 0.2, 0, board)
        text('The Crazed Clip flees!', 0.2, 0, board)
        torewards(false, board)
      } else {
        board.drawsprite('Crazed Clip', 'attack0')
        dealdamage(5, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Crazed Clip pokes you', [], 0.2, board)
        board.drawsprite('Crazed Clip', 'default0')
      }
      break
    case 'Egg':
      //Egg
      text('Egg.', 0.2, 0, board)
      break
    case 'THE BOSS':
      //THE BOSS can do many things, but everything depends on a 6-turn cycle and what phase he's in
      //Phase 1:
      //Turn 1: Remove all of a random item from your inventory
      //Turn 2: Strong attack
      //Turn 3: Reduce all spell's charge counts by 10
      //Turn 4: Attack 3 times, each with increasing power
      //Turn 5: Increase ATK and DEF by 20%
      //Turn 6: Enormous attack
      //Phase 2:
      //Turn 1: Pretty strong attack
      //Turn 2: Removes a random spell from your spellbook
      //Turn 3: Strong attack
      //Turn 4: Medium attack, then reduces your level by 3
      //Turn 5: Increase ATK and DEF by 20%
      //Turn 6: Strongest attack

      //Check the name color to see what phase we are on
      if (board.getenemynamecolor()=='#d9d9d9') {  //Phase 1
        //First all of the dialogue is handled
        if (turn==1 && board.getenemycurrenthp()==board.getenemymaxhp()) {
          text('You think you can defeat me without attacking? Pathetic.', 1.5, 'THE BOSS', board)
          text("So YOU'RE the one stealing the functions!", 1.5, 'THE BOSS', board)
          text("I hope you didn't need these!", 0.5, 'THE BOSS', board)
        }
        else if (turn==1) {
          text('Pathetic.', 1, 'THE BOSS', board)
          text("So YOU'RE the one stealing the functions!", 1.5, 'THE BOSS', board)
          text("I hope you didn't need these!", 0.5, 'THE BOSS', board)
        }
        else if (turn==2) {
          text('You should have stayed quiet in here!', 1.5, 'THE BOSS', board)
        }
        else if (turn==3) {
          text("You're really forcing my hand here", 1.5, 'THE BOSS', board)
          text("Cool book. I can tell it's the source of your power.", 1.5, 'THE BOSS', board)
          text("Let's just...", 0.5, 'THE BOSS', board)
        }
        else if (turn==4) {
          text('Was all of this really necessary?', 1.5, 'THE BOSS', board)
        }
        else if (turn==5) {
          text('You brought this upon yourself you know.', 1.5, 'THE BOSS', board)
        }
        else if (turn==6) {
          text('Enough. Time to end this.', 1.5, 'THE BOSS', board)
        }
        else {
          let bosstext = Math.random()
          if (bosstext<0.25) {text('Is that all you got?', 1.5, 'THE BOSS', board)}
          else if (bosstext<0.5) {text('*Sigh* Truly pathetic...', 1.5, 'THE BOSS', board)}
          else if (bosstext<0.75) {text("Why won't you just give in?", 1.5, 'THE BOSS', board)}
          else if (bosstext<0.999) {text('Begone.', 1.5, 'THE BOSS', board)}
          else {text(`Somebody once told me the world is gonna roll me. I ain't the sharpest tool in the shed. She was looking kind of dumb with her finger and her thumb in the shape of an "L" on her forehead. Well, the years start comin' and they don't stop comin'. Fed to the rules and I hit the ground runnin'. Didn't make sense not to live for fun. Your brain gets smart but your head gets dumb. So much to do, so much to see. So what's wrong with taking the backstreets?. You'll never know if you don't go. You'll never shine if you don't glow. Hey now, you're an all star, get your game on, go play. Hey now, you're a rock star, get the show on, get paid. And all that glitters is gold. Only shootin' stars break the mold. It's a cool place, and they say it gets colder. You're bundled up now, wait 'til you get older. But the meteor men beg to differ judging by the hole in the satellite picture. The ice we skate is gettin' pretty thin. The water's gettin' warm so you might as well swim. My world's on fire, how 'bout yours?. That's the way I like it and I'll never get bored. Hey now, you're an all star, get your game on, go play. Hey now, you're a rock star, get the show on, get paid. All that glitters is gold. Only shootin' stars break the mold. Hey now, you're an all star, get your game on, go play. Hey now, you're a rock star, get the show on, get paid. And all that glitters is gold. Only shooting stars... Somebody once asked, "Could I spare some change for gas? I need to get myself away from this place." I said, "Yep, what a concept I could use a little fuel myself and we could all use a little change." Well, the years start comin' and they don't stop comin'. Fed to the rules and I hit the ground runnin'. Didn't make sense not to live for fun. Your brain gets smart but your head gets dumb. So much to do, so much to see. So what's wrong with taking the backstreets? You'll never know if you don't go. You'll never shine if you don't glow. Hey now, you're an all star, get your game on, go play. Hey now, you're a rock star, get the show on, get paid. And all that glitters is gold. Only shootin' stars break the mold. And all that glitters is gold. Only shootin' stars break the mold............. Ahem - Excuse me.`, 1.5, 'THE BOSS', board)}
          //I find this hilarious, 0.1% chance after turn 6 to say this.
        }
      
        if (turn%6==1) {
          //Delete all of a random item (Not items immune to disable)
          if (board.getnumberofitemrows()==0) {
            //If there are no items to delete, do a standard attack
            dealdamage(13, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS strikes a hard blow', [], 0.2, board)
          } else {
            let bossranditem = Math.floor(Math.random()*board.getnumberofitemrows())+1
            let bossstartingitem = bossranditem
            do {
              if (!immuneitems.includes(board.getitemname(bossranditem))) {break}
              bossranditem = (bossranditem+1)%board.getnumberofitemrows()
            } while (bossranditem!=bossstartingitem)
            if (immuneitems.includes(board.getitemname(bossranditem))) {
              //If there are no items to delete, do a standard attack (This one is when you have items that are immune to being disabled)
              dealdamage(13, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS strikes a hard blow', [], 0.2, board)
            } else {
              removeitem('ALL', bossranditem, board)
              recalculatestats(0, board)
              text('THE BOSS deleted all of your '+board.getitemname(bossranditem)+'!', 0.2, 0, board)
            }
          }
        }
        else if (turn%6==2) {
          //Standard attack
          dealdamage(8, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS attacks without mercy', [], 0.2, board)
        }
        else if (turn%6==3) {
          //Remove 10 charges from every spell
          for (let bossspellnum=board.getnumberofspells(); bossspellnum!=0; bossspellnum--) {
            if (board.getspellcharges(bossspellnum)!='∞') {decrementcharges(bossspellnum, 'no RANDARRAY', 10, board)}
          }
          text("THE BOSS reduced all spell charges by 10!", 0.2, 0, board)
        }
        else if (turn%6==4) {
          //Flurry of attacks
          for (let i=0; i<3; i++) {
            dealdamage(2+i, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS attacks in a frenzy', [], 0.2, board)
            board.pause(0.2)
          }
        }
        else if (turn%6==5) {
          //Increase ATK and DEF by 20%
          text('THE BOSS seems to be preparing something...', 0.2, 0, board)
          board.setenemyatk(Math.ceil(board.getenemyatk()*1.2))
          board.setenemydef(Math.ceil(board.getenemydef()*1.2))
          text('THE BOSS increased its ATK and DEF', 0.2, 0, board)
        }
        else if (turn%6==0) {
          //Strong attack
          dealdamage(15, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS unleashes the stored power', [], 0.2, board)
        }
      } else {  //Phase 2
        //First handle all of the phase 2 dialogue
        if (turn==1) {
          text("I'M DONE PLAYING AROUND!", 1.5, 'THE BOSS', board)
          text('NO MORE LEEWAY!', 1.5, 'THE BOSS', board)
          text('HAVE AT YOU!', 0.5, 'THE BOSS', board)
        }
        else if (turn==2) {text('SAY GOODBYE TO YOUR POWER!', 1.5, 'THE BOSS', board)}
        else if (turn==3) {text('JUST STOP RESISTING!', 1.5, 'THE BOSS', board)}
        else if (turn==4) {text("YOU WON'T WIN!", 1.5, 'THE BOSS', board)}
        else if (turn==5) {text('THIS IS YOUR LAST WARNING!', 1.5, 'THE BOSS', board)}
        else if (turn==6) {text("IT'S TIME!", 1.5, 'THE BOSS', board)}
        else {
          let bosstext = Math.random()
          if (bosstext<0.25) {text('IS THIS ALL OF YOUR POWER?', 1.5, 'THE BOSS', board)}
          else if (bosstext<0.5) {text('YOU. WILL. NOT. WIN!', 1.5, 'THE BOSS', board)}
          else if (bosstext<0.75) {text('THIS IS IT FOR YOU!', 1.5, 'THE BOSS', board)}
          else {text("WHY WON'T YOU JUST QUIT?", 1.5, 'THE BOSS', board)}
        }
      
        if (turn%6==1) {
          //Standard attack
          dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS attacks wildly', [], 0.2, board)
        }
        else if (turn%6==2) {
          //If there is only one spell left in the spellbook, do a standard attack
          if (board.getnumberofspells()==1) {
          dealdamage(12, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS strikes a strong blow', [], 0.2, board)
          }
          //Remove a random spell from your spellbook
          bossrandomspell=Math.ceil(Math.random()*board.getnumberofspells()+1)
          removespell(bossrandomspell, 'no', board)
          text('THE BOSS removed '+board.getspellname(bossrandomspell)+' from your spellbook!', 0.2, 0, board)
        }
        else if (turn%6==3) {
          //Stronger attack
          dealdamage(15, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS attacks in a blinding rage', [], 0.2, board)
        }
        else if (turn%6==4) {
          //Relatively weak attack, and lowers your level by 3
          dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS strikes a devastating blow', [], 0.2, board)
          board.setlevel(Math.max(board.getlevel()-3, 1))
          recalculatestats(0, board)
          text('THE BOSS reduced your level!', 0.2, 0, board)
        }
        else if (turn%6==5) {
          //Increase ATK and DEF by 20%
          text('THE BOSS seems to be preparing something...', 0.2, 0, board)
          board.setenemyatk(Math.ceil(board.getenemyatk()*1.2))
          board.setenemydef(Math.ceil(board.getenemydef()*1.2))
          text('THE BOSS increased its ATK and DEF', 0.2, 0, board)
        }
        else if (turn%6==0) {
          //Huge attack, like huger than it has any right to be
          dealdamage(25, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'THE BOSS unleashes the immense power', [], 0.2, board)
        }
      }
      break
  }
}

function defeatenemy(board) {
  Logger.log("defeatenemy, 2627")

  //Get the enemy's name since a lot of these behaviors are enemy-dependant
  let enemyname = board.getenemyname()

  //Handle the death behavior of enemies
  //Chartclaw has slightly different wording
  if (enemyname=='Chartclaw') {
    text('Chartclaw was defeated!', 0.2, 0, board)
  //Hydraxponent's revivals
  } else if (enemyname=='Hydraxponent') {
    //Revive from 1 head
    if (board.getenemyvar2()==0) {
      board.drawsprite('Hydraxponent', 'defeat0')
      text('The Hydraxponent was defeated!', 2, 0, board)
      board.drawsprite('Hydraxponent', 'default0')
      board.setenemycurrenthp(board.getenemymaxhp())
      board.updateenemyhpbar()
      text('Wait no...', 0.5, 0, board)
      board.drawsprite('Hydraxponent', 'default1')
      board.setenemymaxhp(board.getenemymaxhp()*2)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.setenemyvar1(2)
      board.setenemyvar2(1)
      text('It came back with an extra head!', 0.2, 0, board)
      return
    //Revive from 2 heads
    } else if (board.getenemyvar2()==1) {
      board.drawsprite('Hydraxponent', 'defeat1')
      text('The Hydraxponent was defeated... Again...', 2, 0, board)
      board.drawsprite('Hydraxponent', 'default1')
      board.setenemymaxhp(board.getenemymaxhp()*2)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.updateenemyhpbar()
      text("It's happening again isn't it...", 0.5, 0, board)
      board.drawsprite('Hydraxponent', 'default3')
      board.setenemymaxhp(board.getenemymaxhp()*2)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.setenemyvar1(4)
      board.setenemyvar2(2)
      text('It came back with 2 more heads than last time!', 0.2, 0, board)
      return
    //Revive from 4 heads
    } else if (board.getenemyvar2()==2) {
      board.drawsprite('Hydraxponent', 'defeat2')
      text('The Hydraxponent was defeated once again...', 2, 0, board)
      board.drawsprite('Hydraxponent', 'default3')
      board.setenemymaxhp(board.getenemymaxhp()*4)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.updateenemyhpbar()
      text('Yep, one more time...', 0.5, 0, board)
      board.drawsprite('Hydraxponent', 'default7')
      board.setenemymaxhp(board.getenemymaxhp()*2)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.setenemyvar1(8)
      board.setenemyvar2(3)
      text('It came back with 8 heads!', 0.2, 0, board)
      return
    //No more revives
    } else {
      board.drawsprite('Hydraxponent', 'defeat3')
      text('The Hydraxponent was defeated?', 2, 0, board)
      board.setcolors(7, 12, 18, 16, '#ffffff')
      text("Yes, it's finally defeated", 0.2, 0, board)
    }
  //The Crazed Clip's bonus charges (The actual charges are added in the "getexp" function, but the death message should also be different)
  } else if (enemyname=='Crazed Clip') {
    text('The Clip was attached to your spellbook, all spells gained 5 charges!', 0.2, 0, board)
  //THE BOSS's second phase and beating the game
  } else if (enemyname=='THE BOSS') {
    if (board.getenemyvar1()==0) {
      text("Heh. You think that's the end?", 3, 'THE BOSS', board)
      text('No...', 2, 'THE BOSS', board)
      text("No, I don't think so.", 3, 'THE BOSS', board)
      board.drawsprite('THE BOSS', 'default1')
      board.setenemynamecolor('#ea9999')
      board.cleardisplay()
      text('THE BOSS is angry now!', 0.2, 0, board)
      board.setenemycurrenthp(board.getenemymaxhp())
      board.updateenemyhpbar()
      return
    } else {
      beatthegame(board)
    }
  //Everything else
  } else {
    text('The '+enemyname+' was defeated!', 0.2, 0, board)
  }

  //Standard death behavior:

  //Inc the kill count
  board.inckillcount(enemyname)

  //Detect the presence of certain items
  let items = detectitems(['REPT', 'MIN'], board)
  let rept = items[0]
  let min = items[1]

  //Handle the end-of-wave items
  if (rept>0) {heal(3*rept, 'flat', 'player', 'REPT activated', board)}
  if (min>0) {heal(5*min, 'percent', 'player', 'MIN activated', board)}
  if (min>0 || rept>0) {board.pause(0.2)}

  //Check for any unlocks triggered at the end of a fight
  if (board.getwavecount()==10 && !board.issheetmancerunlocked()) {
    board.unlocksheetmancer()
    Browser.msgBox('You unlocked the Sheetmancer class!', 'By completing wave 10, you unlocked the Sheetmancer class to try out in future runs!', Browser.Buttons.OK)
  }
  else if (board.getwavecount()==25 && !board.isrowgueunlocked()) {
    board.unlockrowgue()
    Browser.msgBox('You unlocked the Rowgue class!', 'By completing wave 25, you unlocked the Rowgue class to try out in future runs!', Browser.Buttons.OK)
  }
  else if (board.getwavecount()==100 && board.getcurrentdifficulty()!='Intern' && !board.isauditshadeunlocked()) {
    board.unlockauditshade()
    Browser.msgBox('You unlocked the Auditshade class!', 'By completing wave 100 on at least Associate difficulty, you unlocked the Auditshade class to try out in future runs!', Browser.Buttons.OK)
  }
  if (board.getplayerdef()>=1000 && !board.ismacroknightunlocked()) {
    board.unlockmacroknight()
    Browser.msgBox('You unlocked the Macroknight class!', 'By finishing a wave with at least 1,000 DEF, you unlocked the Macroknight class to try out in future runs!', Browser.Buttons.OK)
  }

  //Get the exp and money from defeating the enemy
  getexp(board)

  //Reset the NOW buff without triggering the self-damage
  board.setnowbuff(0)
  board.setplayerswordscolor('#d9d9d9')
  board.setplayershieldcolor('#d9d9d9')
  board.setplayerstaffcolor('#d9d9d9')
  board.setplayerclovercolor('#d9d9d9')

  //If a boss was killed, go to the shop, otherwise go to the rewards
  board.pause(1)
  if (board.getwavecount()%25==0) {toshop(board)}
  else {torewards(false, board)}
}

function beatthegame(board) {
  Logger.log("beatthegame, 2773")

  //Finish THE BOSS fight
  text('Heh... hahh...', 3, 'THE BOSS', board)
  text('Good... job...', 3, 'THE BOSS', board)
  text('I guess this is the end...', 3, 'THE BOSS', board)
  text('I have one last thing to say...', 3, 'THE BOSS', board)
  text("YOU'LL REGRET THIS!", 3, 'THE BOSS', board)
  board.setmanys(25, 12, 6, 1, [['value', ''], ['color', '#d9d9d9'], ['fontcolor', '#000000'], ['boldness', 'normal']])
  board.setcolors(7, 12, 18, 16, '#ffffff')
  board.setmanys(2, 12, 4, 15, [['value', ''], ['color', '#d9d9d9']])
  text('You defeated THE BOSS!', 3, 0, board)

  //Find the portal
  text('Is that...', 2, 0, board)
  drawexitportal(board)
  text('Yes! The exit!', 3, 0, board)
  text("It's time to go home.", 1.5, 0, board)
  board.pause(1.5)

  //Check for unlocks triggered by beating the game
  if ((board.getcurrentdifficulty()=='Associate' || board.getcurrentdifficulty()=='Manager') && !board.ishyperlinkerunlocked()) {
    board.unlockhyperlinker()
    Browser.msgBox('You unlocked the Hyperlinker class!', 'By beating the game on at least Associate difficulty, you unlocked the Hyperlinker class to try out in future runs!', Browser.Buttons.OK)
  }
  if (board.getcurrentdifficulty()=='CEO' && !board.iserrorunlocked()) {
    board.unlockerror()
