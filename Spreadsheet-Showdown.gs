//One object of this "boarddata" class is created at the very start of the code
//This object is responsible for all of the changes to the sheet
//The reason this was made is because pulling information directly from the sheet is slow, so this object stores an internal copy of all relevant info on the sheet and whenever the sheet should be changed, it also changes its copy, and when information from the sheet is needed, it draws from its own copy which runs much faster
//THIS WAS A HUGE PAIN TO IMPLEMENT
//Originally everything just modified the sheet directly while keeping a "boardvalues" and "boardcolors" array somewhat updated, but it was not sustainable to not update both simultaneously, so I MANUALLY combed through ALL ~6000 lines for each reference to the "sheet" and those other arrays and changed them to the corresponding, custom-made "board" references
class boarddata {
  constructor() {
    this.sheet = SpreadsheetApp.getActive().getSheetByName('Spreadsheet Showdown')
    this.activecell = this.sheet.getActiveCell()
    //This is used for bug-testing in order to run the code directly from this screen rather than from the sheet
    //this.activecell = this.sheet.getRange('AC8')
    this.activecellcol = this.activecell.getColumn()-1
    this.activecellrow = this.activecell.getRow()-1
    this.boardvalues = this.sheet.getRange('A1:AN1000').getValues()
    this.boardcolors = this.sheet.getRange('A1:AN1000').getBackgrounds()
    this.boardfontcolors = this.sheet.getRange('A1:AN50').getFontColors()
    this.boardbolds = this.sheet.getRange('A1:AN50').getFontWeights()
    this.boarditalics = this.sheet.getRange('A1:AN50').getFontStyles()
    this.boardfontsizes = this.sheet.getRange('A1:AN50').getFontSizes()
    this.boardfonts = this.sheet.getRange('A1:AN50').getFontFamilies()
    this.boardhorizaligns = this.sheet.getRange('A1:AN50').getHorizontalAlignments()
    this.boardvertaligns = this.sheet.getRange('A1:AN50').getVerticalAlignments()
    this.boardtextwraps = this.sheet.getRange('A1:AN50').getWraps()
    //Here's all of the weird characters that I'm using
    this.infinity = '∞'
    this.hearticon = '♥'
    this.swordicon = '⚔'
    this.shieldicon = '⛊'
    this.stafficon = '༒︎'
    this.clovericon = '☘︎'
    this.backicon = '⌫'
    this.internicon = '𖧋'
    this.associateicon = '𖣠'
    this.managericon = '⨂'
    this.executiveicon = '⨷'
    this.ceoicon = '☠︎︎'
    this.biticon = '฿'
    this.chipicon = '⌨'
    this.leftarrow = '←'
    this.rightarrow = '→'
  }

