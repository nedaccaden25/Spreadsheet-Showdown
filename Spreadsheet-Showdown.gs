function recalcrelative(hp, atk, def, mag, luck, board) {
  Logger.log("recalcrelative, 4062")
  //Determine how the stats relate to each other
  let hpnumgreater = 0
  let atknumgreater = 0
  let defnumgreater = 0
  let magnumgreater = 0
  let lucknumgreater = 0
  if (hp<atk) {hpnumgreater++}
  if (hp<def) {hpnumgreater++}
  if (hp<mag) {hpnumgreater++}
  if (hp<luck) {hpnumgreater++}
  if (atk<hp) {atknumgreater++}
  if (atk<def) {atknumgreater++}
  if (atk<mag) {atknumgreater++}
  if (atk<luck) {atknumgreater++}
  if (def<hp) {defnumgreater++}
  if (def<atk) {defnumgreater++}
  if (def<mag) {defnumgreater++}
  if (def<luck) {defnumgreater++}
  if (mag<hp) {magnumgreater++}
  if (mag<atk) {magnumgreater++}
  if (mag<def) {magnumgreater++}
  if (mag<luck) {magnumgreater++}
  if (luck<hp) {lucknumgreater++}
  if (luck<atk) {lucknumgreater++}
  if (luck<def) {lucknumgreater++}
  if (luck<mag) {lucknumgreater++}

  //Put the greater counts into a sorted list
  let greatercountlist = [hpnumgreater, atknumgreater, defnumgreater, magnumgreater, lucknumgreater]
  greatercountlist.sort()

  //Determine which stats are in which places
  let hpplaces = ''
  let atkplaces = ''
  let defplaces = ''
  let magplaces = ''
  let luckplaces = ''
  let stattocheck = ''

  let stats
  for (let i=0; i<5; i++) {
    stats = ['hp', 'atk', 'def', 'mag', 'luck']
    stattocheck = stats[i]
    if (eval(stattocheck+'numgreater')==greatercountlist[0]) {eval(stattocheck+'places = '+stattocheck+'places+"Highest & "')}
    if (eval(stattocheck+'numgreater')==greatercountlist[1]) {eval(stattocheck+'places = '+stattocheck+'places+"Second highest & "')}
    if (eval(stattocheck+'numgreater')==greatercountlist[2]) {eval(stattocheck+'places = '+stattocheck+'places+"Third highest & "')}
    if (eval(stattocheck+'numgreater')==greatercountlist[3]) {eval(stattocheck+'places = '+stattocheck+'places+"Fourth highest & "')}
    if (eval(stattocheck+'numgreater')==greatercountlist[4]) {eval(stattocheck+'places = '+stattocheck+'places+"Lowest & "')}
    eval(stattocheck+'places = '+stattocheck+'places.slice(0, -3)')
  }

  //Create variables to store the final values of the stats to prevent the originals from being overwritten
  let finalhp = hp
  let finalatk = atk
  let finaldef = def
  let finalmag = mag
  let finalluck = luck
  
  //Get the items that affect your stats relative to each other
  let items = detectitems(['LAMBDA', 'AVERAGE', 'ISBETWEEN', 'SECOND', 'FORECAST', 'MODE'], board)
  let lambda = items[0]
  let average = items[1]
  let isbetween = items[2]
  let second = items[3]
  let forecast = items[4]
  let mode = items[5]

  //Time to handle each item individually
  if (lambda>0) {
    if (hpnumgreater==0)
    {finalhp=finalhp+5*lambda}
    if (atknumgreater==0)
    {finalatk=finalatk+5*lambda}
    if (defnumgreater==0)
    {finaldef=finaldef+5*lambda}
    if (magnumgreater==0)
    {finalmag=finalmag+5*lambda}
    if (lucknumgreater==0)
    {finalluck=finalluck+5*lambda}
  }
  if (average>0) {
    if (hpnumgreater==greatercountlist[greatercountlist.length-1])
    {finalhp=finalhp+5*average}
    if (atknumgreater==greatercountlist[greatercountlist.length-1])
    {finalatk=finalatk+5*average}
    if (defnumgreater==greatercountlist[greatercountlist.length-1])
    {finaldef=finaldef+5*average}
    if (magnumgreater==greatercountlist[greatercountlist.length-1])
    {finalmag=finalmag+5*average}
    if (lucknumgreater==greatercountlist[greatercountlist.length-1])
    {finalluck=finalluck+5*average}
  }
  if (isbetween>0) {
    if (hpnumgreater==greatercountlist[2]) {finalhp=finalhp*(1+0.1*isbetween)}
    if (atknumgreater==greatercountlist[2]) {finalatk=finalatk*(1+0.1*isbetween)}
    if (defnumgreater==greatercountlist[2]) {finaldef=finaldef*(1+0.1*isbetween)}
    if (magnumgreater==greatercountlist[2]) {finalmag=finalmag*(1+0.1*isbetween)}
    if (lucknumgreater==greatercountlist[2]) {finalluck=finalluck*(1+0.1*isbetween)}
  }
  if (second>0) {
    if (hpnumgreater==greatercountlist[1]) {finalhp=finalhp*(1+0.1*second)}
    if (atknumgreater==greatercountlist[1]) {finalatk=finalatk*(1+0.1*second)}
    if (defnumgreater==greatercountlist[1]) {finaldef=finaldef*(1+0.1*second)}
    if (magnumgreater==greatercountlist[1]) {finalmag=finalmag*(1+0.1*second)}
    if (lucknumgreater==greatercountlist[1]) {finalluck=finalluck*(1+0.1*second)}
  }
  if (forecast>0) {
    if (lucknumgreater==0) {
      finalluck=finalluck*(1+forecast)
    }
  }
  if (mode>0) {
    let hpflag=0
    let atkflag=0
    let defflag=0
    let magflag=0
    let luckflag=0

    if (Math.abs(hp-atk)/((hp+atk)/2)<=0.05) {hpflag=1; atkflag=1}            //hp vs atk
    if (Math.abs(hp-def)/((hp+def)/2)<=0.05) {hpflag=1; defflag=1}            //hp vs def
    if (Math.abs(hp-mag)/((hp+mag)/2)<=0.05) {hpflag=1; magflag=1}            //hp vs mag
    if (Math.abs(hp-luck)/((hp+luck)/2)<=0.05) {hpflag=1; luckflag=1}         //hp vs luck
    if (Math.abs(atk-def)/((atk+def)/2)<=0.05) {atkflag=1; defflag=1}         //atk vs def
    if (Math.abs(atk-mag)/((atk+mag)/2)<=0.05) {atkflag=1; magflag=1}         //atk vs mag
    if (Math.abs(atk-luck)/((atk+luck)/2)<=0.05) {atkflag=1; luckflag=1}      //atk vs luck
    if (Math.abs(def-mag)/((def+mag)/2)<=0.05) {defflag=1; magflag=1}         //def vs mag
    if (Math.abs(def-luck)/((def+luck)/2)<=0.05) {defflag=1; luckflag=1}      //def vs luck
    if (Math.abs(mag-luck)/((mag+luck)/2)<=0.05) {magflag=1; luckflag=1}      //mag vs luck

    if (hpflag==1) {finalhp=finalhp*(1+mode)}
    if (atkflag==1) {finalatk=finalatk*(1+mode)}
    if (defflag==1) {finaldef=finaldef*(1+mode)}
    if (magflag==1) {finalmag=finalmag*(1+mode)}
    if (luckflag==1) {finalluck=finalluck*(1+mode)}
  }

  //Round up any decimal component
  finalhp=Math.ceil(finalhp)
  finalatk=Math.ceil(finalatk)
  finaldef=Math.ceil(finaldef)
  finalmag=Math.ceil(finalmag)
  finalluck=Math.ceil(finalluck)

  //Return the finalized stats and their positions relative to each other
  return([[finalhp, hpplaces], [finalatk, atkplaces], [finaldef, defplaces], [finalmag, magplaces], [finalluck, luckplaces]])
}

function decrementcharges(index, userandarray, decreaseby, board) {
  Logger.log("decrementcharges, 4211")
  if (userandarray=='use RANDARRAY') {
    //Detect the presence of certain items
    let items = detectitems(['RANDARRAY'], board)
    let randarray = items[0]

    //Check if the charges shouldn't decrement due to RANDARRAY, checking each singular decrement individually (due to DOLLAR)
    if (randarray>0) {
      for (let i=0; i<decreaseby; ) {
        if (Math.random()<randarray/50) {decreaseby--} else {i++}
      }
    }
  }

  //If it has none now, automatically remove it
  if (board.getspellcharges(index)-decreaseby<=0) {removespell(index, 'no', board)}

  //Otherwise, Reduce the amount of charges it has
  else {board.setspellcharges(index, board.getspellcharges(index)-decreaseby)}
}

function text(message, texttimer, speaker, board) {
  Logger.log("text, 4233")
  //Put the top five messages that are currently displayed in an array to rewrite them in different spots
  let currenttext = board.getvalues(25, 12, 5, 1)

  //Get the colors of the text to determine which ones are boss text or Alex text
  let textcolors = board.getcolors(25, 12, 5, 1)

  //Reset the formatting of the messages
  board.setmanys(25, 12, 6, 1, [['color', '#d9d9d9'], ['fontcolor', '#000000'], ['boldness', 'normal']])

  //Put the messages in the spot one below where they were
  board.setvaluesarr(26, 12, 5, 1, currenttext)

  //Now fix the formatting of any boss text or Alex text that was moved
  for (let i=0; i<5; i++) {
    if (textcolors[i][0]=='#000000') {
      board.setmany(26+i, 12, [['color', '#000000'], ['fontcolor', '#ff0000'], ['boldness', 'bold']])
    }
    else if (textcolors[i][0]=='#b7b7b7') {
      board.setmany(26+i, 12, [['color', '#b7b7b7'], ['fontcolor', '#1155cc']])
    }
  }

  //Insert the new text into the top spot (Pause for dramatic effect for boss text or Alex text)
  if (speaker=='THE BOSS') {
    board.setmany(25, 12, [['value', message], ['color', '#000000'], ['fontcolor', '#ff0000'], ['boldness', 'bold']])
  } else if (speaker=='Alex') {
    board.setmany(25, 12, [['value', message], ['color', '#b7b7b7'], ['fontcolor', '#1155cc']])
  } else {
    board.setvalue(25, 12, message)
  }

  //Pause for the specified amount of time
  if (texttimer>0) {
    board.pause(texttimer)
  }
}

