function datafile(filenum, board) {
  Logger.log("datafile, 5053")
  //Ask if you want to load the file
  let yesno = Browser.msgBox('Load file '+filenum+'?', '', Browser.Buttons.YES_NO)

  if (yesno=='no') {
    //Then ask if this file should be deleted
    yesno = Browser.msgBox('Delete file '+filenum+'?', '', Browser.Buttons.YES_NO)

    if (yesno!='yes') {return}
    else {
      //Then ask if the file should really be deleted
      yesno = Browser.msgBox('Are you sure you want to delete file '+filenum+'?', 'You will not be able to recover this file once it is deleted... Are you sure you still want to delete it?', Browser.Buttons.YES_NO)
        
      if (yesno!='yes') {return}
      else {
        //Delete the selected file
        board.setvalues(99+filenum*100, 0, 100, 40, '')
        board.setcolor(3+4*filenum, 12, '#cccccc')
        board.setmanys(3+filenum*4, 14, 3, 14, [['merge', 'all'], ['value', 'NEW GAME'], ['fontsize', 30], ['border', ['top', 'left', 'right', 'bottom']], ['vertalign', 'middle'], ['horizalign', 'center']])
        Browser.msgBox('File '+filenum+' deleted', '', Browser.Buttons.OK)
        return
      }
    }
  } else if (yesno=='yes') {
    //Load the file
    loadfile(filenum, board)
  }
}

function emptyfile(filenum, board) {
  Logger.log("emptyfile, 5083")
  //Ask if a new game should begin
  let yesno = Browser.msgBox('Start a new game in file '+filenum+'?', '', Browser.Buttons.YES_NO)

  if (yesno!='yes') {return}

  //Start a new game

  let flag = 0
  let character
  let difficulty

  while (flag==0) {
    //Determine what classes are available
    let classlist = ''
    if (board.iscellbladeunlocked()) {classlist=classlist+'\\n'+'Cellblade'}
    if (board.issheetmancerunlocked()) {classlist=classlist+'\\n'+'Sheetmancer'}
    if (board.isrowgueunlocked()) {classlist=classlist+'\\n'+'Rowgue'}
    if (board.ismacroknightunlocked()) {classlist=classlist+'\\n'+'Macroknight'}
    if (board.isstacklericunlocked()) {classlist=classlist+'\\n'+'Stackleric'}
    if (board.isauditshadeunlocked()) {classlist=classlist+'\\n'+'Auditshade'}
    if (board.ishyperlinkerunlocked()) {classlist=classlist+'\\n'+'Hyperlinker'}
    if (board.iserrorunlocked()) {classlist=classlist+'\\n'+'Error'}
    classlist=classlist+'\\n'+'Enter "help" for details on the classes'

    //Have the player select what class they will play as
    character = Browser.inputBox('What class will you become in the sheets?', 'Available classes:'+classlist, Browser.Buttons.OK_CANCEL)
    character = character.toLowerCase()
    if (character=='cancel') {return}
    character = character.charAt(0).toUpperCase()+character.slice(1)
    if (character=='Cellblade' || character=='Sheetmancer' || character=='Rowgue' || character=='Macroknight' || character=='Stackleric' || character=='Auditshade' || character=='Hyperlinker' || character=='Error') {flag=1}
    else if (character=='Help') {
      if (board.iscellbladeunlocked()) {Browser.msgBox('Cellblade', 'The default class. Pretty average across the board, but specializes in ATK'+'\\n'+'Strengths: ATK'+'\\n'+'Weaknesses: MAG, LUCK', Browser.Buttons.OK)}
      if (board.issheetmancerunlocked()) {Browser.msgBox('Sheetmancer', 'The Sheetmancer is a more powerful magic user, at the cost of some bulkiness'+'\\n'+'Strengths: MAG'+'\\n'+'Weaknesses: ATK, LUCK', Browser.Buttons.OK)}
      if (board.isrowgueunlocked()) {Browser.msgBox('Rowgue', 'The Rowgue is a very lucky class that gets stronger with more LUCK'+'\\n'+'Strengths: LUCK'+'\\n'+'Weaknesses: HP, DEF', Browser.Buttons.OK)}
      if (board.ismacroknightunlocked()) {Browser.msgBox('Macroknight', 'The Macroknight is a bulky class that is made to withstand any attack'+'\\n'+'Strengths: HP, DEF'+'\\n'+'Weaknesses: MAG, LUCK', Browser.Buttons.OK)}
      if (board.isstacklericunlocked()) {Browser.msgBox('Stackleric', 'The Stackleric is an effective magic attacker with heals to stay alive'+'\\n'+'Strengths: HP, MAG'+'\\n'+'Weaknesses: ATK, DEF, LUCK', Browser.Buttons.OK)}
      if (board.isauditshadeunlocked()) {Browser.msgBox('Auditshade', 'The Auditshade is a manipulative class that weakens enemies to strengthen themself'+'\\n'+'Strengths: ATK'+'\\n'+'Weaknesses: DEF, LUCK', Browser.Buttons.OK)}
      if (board.ishyperlinkerunlocked()) {Browser.msgBox('Hyperlinker', 'The Hyperlinker is a class that starts weak, but builds power with more resources'+'\\n'+'Strengths: None'+'\\n'+'Weaknesses: HP, DEF, MAG, LUCK', Browser.Buttons.OK)}
      if (board.iserrorunlocked()) {Browser.msgBox('Error', '#ERROR! "DESC NOT FOUND"', Browser.Buttons.OK)}
    } else {Browser.msgBox('Invalid Class', '', Browser.Buttons.OK)}
  }
  flag = 0
  while (flag==0) {
    //Determine what difficulties are available
    let difficultylist = ''
    if (board.isinternunlocked()) {difficultylist=difficultylist+'\\n'+'Intern'}
    if (board.isassociateunlocked()) {difficultylist=difficultylist+'\\n'+'Associate'}
    if (board.ismanagerunlocked()) {difficultylist=difficultylist+'\\n'+'Manager'}
    if (board.isexecutiveunlocked()) {difficultylist=difficultylist+'\\n'+'Executive'}
    if (board.isceounlocked()) {difficultylist=difficultylist+'\\n'+'CEO'}
    difficultylist = difficultylist+'\\n'+'Enter "help" for details on the difficulties'

    //Have the player select the difficulty they will play on
    difficulty = Browser.inputBox('What difficulty will you play on?', 'Available difficulties:'+difficultylist, Browser.Buttons.OK_CANCEL)
    difficulty = difficulty.toLowerCase()
    if (difficulty=='cancel') {return}
    difficulty = difficulty.charAt(0).toUpperCase()+difficulty.slice(1)
    if (difficulty=='Ceo') {difficulty='CEO'}
    if (difficulty=='Intern' || difficulty=='Associate' || difficulty=='Manager' || difficulty=='Executive' || difficulty=='CEO') {flag=1}
    else if (difficulty=='Help') {
      if (board.isinternunlocked()) {Browser.msgBox('Intern', "You're just here to learn... And maybe to have some coffee"+'\\n'+'Effects:'+'\\n'+'Decreased enemy scaling speed'+'\\n'+'Full heal on level-up', Browser.Buttons.OK)}
      if (board.isassociateunlocked()) {Browser.msgBox('Associate', 'You know how to format cells and maybe survive a few meetings'+'\\n'+'Effects:'+'\\n'+'None', Browser.Buttons.OK)}
      if (board.ismanagerunlocked()) {Browser.msgBox('Manager', "Now you're responsible for others' mistakes"+'\\n'+'Effects:'+'\\n'+'Increased enemy scaling speed', Browser.Buttons.OK)}
      if (board.isexecutiveunlocked()) {Browser.msgBox('Executive', "You're always busy, always blamed, and always behind"+'\\n'+'Effects:'+'\\n'+'Insane enemy scaling speed'+'\\n'+'All enemies have slightly increased ATK', Browser.Buttons.OK)}
      if (board.isceounlocked()) {Browser.msgBox('CEO', "Automation isn't coming for your job, you are the automation"+'\\n'+'Effects:'+'\\n'+'Ridiculous enemy scaling speed'+'\\n'+'All enemies have moderately increased ATK and DEF'+'\\n'+'All enemies give reduced exp'+'\\n'+'Reduced effectiveness of luck', Browser.Buttons.OK)}
    } else {Browser.msgBox('Invalid Difficulty', '', Browser.Buttons.OK)}
  }

  //Ask if the opening cutscene should be displayed
  if (Browser.msgBox('Would you like to watch the opening cutscene?', '', Browser.Buttons.YES_NO) == 'yes') {board.cutscene()}

  //Create the default save data based on the selected character and difficulty
  let items = []
  let spells = []
  let stats //[HP, ATK, DEF, MAG, LUCK]
  switch (character) {
    case 'Cellblade':
      spells.push(['POW', 'RARITY: Macro, TYPE: Standard, POWER: 15, EFFECT: None', board.infinity, '#ddbc9a'])
      for (let i=0; i<5; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [25, 15, 10, 6, 2]
      break
    case 'Sheetmancer':
      spells.push(['CHAR', 'RARITY: Macro, TYPE: Magic, POWER: 15, EFFECT: None', board.infinity, '#ddbc9a'])
      for (let i=0; i<5; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [20, 5, 8, 13, 2]
      break
    case 'Rowgue':
      items.push(['1', 'PROB', 'RARITY: SHEET, TYPE: Other, EFFECT: Increase ATK and MAG by 20% of your LUCK, this item cannot be disabled by monsters', '#d9d9d9'])
      spells.push(['POISSON', 'RARITY: Formula, TYPE: Standard, POWER: 10, EFFECT: Does extra damage upon a critical hit', board.infinity, '#ddbc9a'])
      for (let i=0; i<5; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [12, 10, 5, 10, 20]
      break
    case 'Macroknight':
      items.push(['1', 'CONFIDENCE', 'RARITY: Table, TYPE: Other, EFFECT: Increase LUCK by 100%, then convert it all into HP, this item cannot be disabled by monsters', '#d9d9d9'])
      spells.push(['EXACT', 'RARITY: Macro, TYPE: Standard, POWER: 10, EFFECT: Combines ATK and DEF to calculate damage', board.infinity, '#ddbc9a'])
      for (let i=0; i<5; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [40, 10, 30, 5, 0]
      break
    case 'Stackleric':
      items.push(['1', 'RATE', 'RARITY: SHEET, TYPE: Standard, EFFECT: Increase the effectiveness of all heals by 50%, this item cannot be disabled by monsters', '#d9d9d9'])
      spells.push(['PROPER', 'RARITY: Formula, TYPE: Magic, POWER: 10, EFFECT: None', '40', '#ddbc9a'])
      spells.push(['CLEAN', 'RARITY: Script, TYPE: Support, EFFECT: Restore 25% of your max HP', board.infinity, '#ddbc9a'])
      for (let i=0; i<4; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [35, 2, 5, 16, 1]
      break
    case 'Auditshade':
      items.push(['1', 'QUOTIENT', 'RARITY: SHEET, TYPE: Standard, EFFECT: Decrease enemy ATK the higher your MAG is, this item cannot be disabled by monsters', '#d9d9d9'])
      spells.push(['RANK', "RARITY: Script, TYPE: Standard, POWER: 15, EFFECT: Increase the power based on how much higher your ATK is compared to the enemy's ATK", board.infinity, '#ddbc9a'])
      spells.push(['INTERCEPT', "RARITY: Script, TYPE: Support, EFFECT: Permanently reduce the enemy's ATK and DEF by 30%", '20', '#ddbc9a'])
      for (let i=0; i<4; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [14, 12, 7, 4, 3]
      break
    case 'Hyperlinker':
      items.push(['3', 'JOIN', 'RARITY: SHEET, MAX: 6, EFFECT: Gain 1 Spell Slot, this item cannot be disabled by monsters', '#d9d9d9'])
      spells.push(['SUBTOTAL', 'RARITY: PROGRAM, TYPE: Standard, POWER: ???, EFFECT: The power is determined by the total number of items you have, and less so by the total number of charges in your spellbook ('+board.infinity+' is treated as 20 charges)', board.infinity, '#ddbc9a'])
      for (let i=0; i<8; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [8, 8, 6, 5, 2]
      break
    case 'Error':
      for (let i=0; i<3; i++) {let randomspell = getrandomspell(board); spells.push([randomspell[0], randomspell[1], randomspell[2], '#ddbc9a'])}
      for (let i=0; i<3; i++) {spells.push(['', '', '', '#ddbc9a'])}
      stats = [20, Math.floor(Math.random()*15+1), Math.floor(Math.random()*15+1), Math.floor(Math.random()*15+1), Math.floor(Math.random()*15+1)]
      break
  }

  //Fill in the items and spells
  while (items.length!=20) {
    items.push(['', '', '', '#d9d9d9'])
  }
  while (spells.length!=12) {
    spells.push(['', '', '', '#999999'])
  }

  //Save this data to the file
  board.setvaluesarr(99+filenum*100, 0, 20, 4, items)
  board.setvaluesarr(119+filenum*100, 0, 12, 4, spells)
  board.setvaluesarr(99+filenum*100, 4, 1, 4, [[character, difficulty, 1, '#d9d9d9']])
  board.setvaluesarr(100+filenum*100, 4, 6, 4, [[0, 100, '', ''], [stats[0], stats[0], '#d9d9d9', '#d9d9d9'], [stats[1], '#d9d9d9', '#d9d9d9', ''], [stats[2], '#d9d9d9', '#d9d9d9', ''], [stats[3], '#d9d9d9', '#d9d9d9', ''], [stats[4], '#d9d9d9', '#d9d9d9', '']])
