function spreadsheetshowdown() {
  Logger.log("spreadsheetshowdown, 1")
  //Return immediately if there is already a function running, otherwise set a flag that indicates a function is running
  //This is done before anything else is read because reading from the sheet just takes too long
  let runningflag = SpreadsheetApp.getActive().getSheetByName('Spreadsheet Showdown').getRange('A32').getValue()
  if (runningflag!=0) {
    if (runningflag==1) {SpreadsheetApp.getActive().getSheetByName('Spreadsheet Showdown').getRange('A32').setValue(2); return}
    else {
      Browser.msgBox("It seems like something's not working right...", "If you left the function running and it timed out, simply delete the contents of cell A32 to continue playing."+'\\n'+'\\n'+'If the function had an error, please do not change any values on the sheet and please let me know and tell me exactly what you were trying to do when it had an error. I will personally fix the error and your game.'+'\\n'+'\\n'+"If neither of these are the case, then stop pressing the button so quickly and have a little patience since, after all, Google Sheets isn't exactly built for handling games like this. Things might happen somewhat slowly so just slow down and let it cook.", Browser.Buttons.OK); return
    }
  }
  else {SpreadsheetApp.getActive().getSheetByName('Spreadsheet Showdown').getRange('A32').setValue(1)}

  //Get the values and colors from the board now, that way they can be referenced easily and quickly
  //(The boarddata object also handles changing the board, this way all changes that are made are mirrored between the internal copy and the board itself, more details at the boarddata class at the bottom of the code)
  let board = new boarddata()

  //THESE ARE ZERO BASED: CELL A1 is (0, 0)
  let col = board.getactivecellcol()
  let row = board.getactivecellrow()

  //Run different code depending on what screen we're on (save the game every time you push the button while in-game)
  switch (board.getscreen()) {
    case '': firstplay(board); break
    case 0: title(row, col, board); break
    case 1: fileselect(row, col, board); break
    case 2: game(row, col, board); if (board.getscreen()==2) {savegame(board)}; break
    case 3: condform(row, col, board); break
    case 4: credits(row, col, board); break
    case 5: logbook(row, col, board); break
  }

  board.end()
}

function firstplay(board) {
  Logger.log('firstplay, 37')
  //This should only run if this is the screen number got deleted
  //Return to the title screen
  gototitle(board)

  //If the permanent unlocks are blank, restore them to the default values
  if (board.getvalue(499, 0)==='') {board.unlockcellblade()}
  if (board.getvalue(500, 0)==='') {board.locksheetmancer()}
  if (board.getvalue(501, 0)==='') {board.lockrowgue()}
  if (board.getvalue(502, 0)==='') {board.lockmacroknight()}
  if (board.getvalue(503, 0)==='') {board.lockstackleric()}
  if (board.getvalue(504, 0)==='') {board.lockauditshade()}
  if (board.getvalue(505, 0)==='') {board.lockhyperlinker()}
  if (board.getvalue(506, 0)==='') {board.lockerror()}
  if (board.getvalue(499, 1)==='') {board.unmastercellblade()}
  if (board.getvalue(500, 1)==='') {board.unmastersheetmancer()}
  if (board.getvalue(501, 1)==='') {board.unmasterrowgue()}
  if (board.getvalue(502, 1)==='') {board.unmastermacroknight()}
  if (board.getvalue(503, 1)==='') {board.unmasterstackleric()}
  if (board.getvalue(504, 1)==='') {board.unmasterauditshade()}
  if (board.getvalue(505, 1)==='') {board.unmasterhyperlinker()}
  if (board.getvalue(506, 1)==='') {board.unmastererror()}
  if (board.getvalue(499, 2)==='') {board.unlockintern()}
  if (board.getvalue(500, 2)==='') {board.unlockassociate()}
  if (board.getvalue(501, 2)==='') {board.unlockmanager()}
  if (board.getvalue(502, 2)==='') {board.lockexecutive()}
  if (board.getvalue(503, 2)==='') {board.lockceo()}
  if (board.getvalue(499, 18)==='') {board.setvalue(499, 18, 1)}
  if (board.getvalue(499, 19)==='') {board.setvalue(499, 19, 0)}
  if (board.getvalue(500, 19)==='') {board.setvalue(500, 19, 0)}
  if (board.getvalue(501, 19)==='') {board.setvalue(501, 19, 0)}
  if (board.getvalue(502, 19)==='') {board.setvalue(502, 19, 0)}
  if (board.getvalue(499, 20)==='') {board.setalexcount(0)}
  if (board.getvalue(500, 20)==='') {board.setwincount(0)}
  for (let i=0; i<20; i++) {
    for (let j=0; j<5; j++) {
      if (board.getvalue(499+i, 30+j)==='') {board.setvalue(499+i, 30+j, 0)}
    }
  }
  if (board.getbits()==='') {board.setbits(0)}
  if (board.getchips()==='') {board.setchips(0)}
}

function title(row, col, board) {
  Logger.log("title, 43")
  //This is the code for the title screen
  //Go to file select if you hit the "start game" button
  if (row==19 && col==15) {tofileselect(board)}
  
  //Otherwise, display a helper message
  else {Browser.msgBox("Welcome to Spreadsheet Showdown!", 'To interact with the game, click on the cell you want to select, then press the "Select" button near the bottom of the screen. Please do not change the values in the cells on or below the game board directly, they will be updated automatically as the game is played', Browser.Buttons.OK)}
}

function fileselect(row, col, board) {
  Logger.log("fileselect, 53")
  //This is the code for the file select screen

  //Determine what file has been selected
  let file = 0
  if (row>=7 && row<=9 && col>=12 && col<=27) {file=1}
  else if (row>=11 && row<=13 && col>=12 && col<=27) {file=2}
  else if (row>=15 && row<=17 && col>=12 && col<=27) {file=3}
  else if (row==19 && col==15) {file=-1}
  else if (row==2 && col==16) {file=-2}
  else if (row==23 && col==16 && board.getvalue(499, 19)==1) {file=-3}

  //If no file was selected, display the same helper message as the title screen
  if (file==0) {Browser.msgBox("Welcome to Spreadsheet Showdown!", 'To interact with the game, click on the cell you want to select, then press the "Select" button near the bottom of the screen. Please do not change the values in the cells on or below the game board directly, they will be updated automatically as the game is played', Browser.Buttons.OK)}

  //If the "back to title" button was selected, go back to the title screen
  else if (file==-1) {gototitle(board)}

  //If the Cond. Form. button was selected, display a temp message
  else if (file==-2) {Browser.msgBox('Whoops!', 'Conditional Formatting is still a work in progress! Come back in a later update to upgrade your spells!', Browser.Buttons.OK)}

  //If the Logbook was selected, open the logbook
  else if (file==-3) {tologbook(board)}

  //If a file was selected, determine if it is empty or not, then run the corresponding code
  else if (file>0 && file<4) {
    if (board.getvalue(99+file*100, 4)=='') {emptyfile(file, board)} else {datafile(file, board)}
  }
}

function credits(row, col, board) {
  Logger.log("credits, 84")
  //This is the code for the credits screen
  //Go to the title screen if you hit the button and delete your current save
  if (row==18 && col==15) {
    let filenum = board.getcurrentfilenum()
    if (filenum>=1 && filenum<=3) {
      board.setvalues(99+100*filenum, 0, 100, 40, '')
    }
    gototitle(board)
  }
}

