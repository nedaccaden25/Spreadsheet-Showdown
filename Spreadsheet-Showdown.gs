    if (monster=='THE BOSS') {return(this.getwincount())}
    let normals = ['Green Sheet Slime', 'Red Sheet Slime', 'Yellow Sheet Slime', 'Cellyfish', 'Adder', 'Cell Crawler', 'Moni-Troll', 'Subtractarine', 'Pensolo']
