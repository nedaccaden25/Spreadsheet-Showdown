  board.setvalue(2, 20, stats[page][1])
  board.setvalue(2, 25, stats[page][2])

  //Insert the resistance
  if (enemies[page]=='???') {board.setvalue(20, 8, '???')}
  else {
    if (standardresists.includes(enemies[page])) {board.setvalue(20, 8, 'Standard')}
    else if (magicresists.includes(enemies[page])) {board.setvalue(20, 8, 'Magic')}
    else {board.setvalue(20, 8, 'None')}
  }

  //Insert the log entries depending on how many kills you have
  board.setvalues(22, 0, 9, 1, '')
  board.setcolors(22, 0, 9, 1, '#d9d9d9')
  for (let i=0; i<entries[page].length; i++) {
    if (board.getkillcount(enemies[page])>=entries[page][i][1]) {board.setvalue(22+i, 0, entries[page][i][0])}
    else {
      board.setvalue(22+i, 0, 'Next log unlocks after defeating '+entries[page][i][1]+' of this monster')
      board.setcolor(22+i, 0, '#999999')
      break
    }
  }

  //Insert the behaviors and color them accordingly
  board.setvalues(22, 20, 9, 1, '')
  board.setcolors(22, 20, 9, 1, '#d9d9d9')
  for (let i=0; i<behaviors[page].length; i++) {
    board.setvalue(22+i, 20, behaviors[page][i][0])
    if (behaviors[page][i][1]=='blue') {board.setcolor(22+i, 20, '#cfe2f3')}
  }

  //Insert the current kill count for the enemy
  board.setvalue(20, 33, board.getkillcount(enemies[page]))

  //Turn the left and right arrows gray if we are on the first or last page
  board.setcolor(10, 6, '#cfe2f3')
  if (page==1) {board.setcolor(10, 6, '#999999')}
  board.setcolor(10, 30, '#cfe2f3')
  if (page==enemies.length-1) {board.setcolor(10, 30, '#999999')}
}

function animatelogbookmonster(animation, monster, board) {
  Logger.log('animatelogbookmonster, 4741')
  //If the selected animation is not blue, display a helper message instead
  if (board.getcolor(22+animation, 20)!='#cfe2f3') {
    Browser.msgBox("These are this monster's behaviors", 'On their turn the monster will choose an attack to perform against you. Select a blue behavior to see the animation for that action', Browser.Buttons.OK)
    return
  }

  //Keep track of if an animation was played
  let animskipped = false

  //This switch case is very similar to the enemy attack switch case, which makes sense since this is supposed to mimic that
  switch(monster) {
    case 'Green Sheet Slime':
      //Lunge:
      if (animation==0) {
        board.drawsprite('Green Sheet Slime', 'attack0')
        board.pause(0.2)
        board.drawsprite('Green Sheet Slime', 'default0')
      } else {animskipped=true}
      break
    case 'Red Sheet Slime':
      //Siphon
      if (animation==0) {
        board.drawsprite('Red Sheet Slime', 'attack0')
        board.pause(0.2)
        board.drawsprite('Red Sheet Slime', 'default0')
      } else {animskipped=true}
      break
    case 'Yellow Sheet Slime':
      //Chunk Throw
      if (animation==0) {
