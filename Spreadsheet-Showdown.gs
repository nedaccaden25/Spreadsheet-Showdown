function tofileselect(board) {
  Logger.log("tofileselect, 4386")
  //First reset all of the title screen cells
  board.setmanys(8, 12, 9, 16, [['unmerge'], ['value', ''], ['color', '#ffffff'], ['fontsize', 10], ['italicness', 'normal'], ['font', 'Oswald'], ['border', ['top', 'left', 'right', 'bottom', 'vertical', 'horizontal']], ['vertalign', 'bottom'], ['horizalign', 'left']])
  board.setmanys(19, 15, 3, 10, [['unmerge'], ['value', ''], ['color', '#ffffff'], ['fontsize', 10], ['border', ['top', 'left', 'right', 'bottom', 'vertical', 'horizontal']], ['vertalign', 'bottom'], ['horizalign', 'left']])

  //Update the screen state to reflect that we are now on the file select screen
  board.setscreen(1)

  //Loop three times to handle each file's formatting
  for (let i=1; i<=3; i++) {
    //Make the box for the file
    board.setmanys(3+4*i, 12, 3, 16, [['border', ['top', 'left', 'right', 'bottom', 'no vertical', 'no horizontal']], ['color', '#cccccc']])

    //Make the file's number
    board.setmanys(3+4*i, 12, 3, 2, [['merge', 'all'], ['value', i], ['fontsize', 30], ['border', ['top', 'left', 'right', 'bottom']], ['vertalign', 'middle'], ['horizalign', 'center']])

    //Color the number red if the "dirty save" flag is set
    if (board.getvalue(102+i*100, 22)==1) {board.setcolor(3+4*i, 12, '#ea9999')}
    
    //Display the file information, if it's empty then display "NEW GAME" instead
    if (board.getvalue(99+i*100, 4)=='') {
      board.setmanys(3+4*i, 14, 3, 14, [['merge', 'all'], ['value', 'NEW GAME'], ['fontsize', 30], ['vertalign', 'center'], ['horizalign', 'middle']])
    } else {
      let enemyname=board.getvalue(99+i*100, 22)
      if (enemyname=='Rewards:' || enemyname=='Shop') {enemyname='None'}
      let itemnum = 0
      for (let j=0; j<20; j++) {itemnum=itemnum+board.getvalue(99+i*100+j, 0)}
      if (itemnum==0) {itemnum='None'}
      board.setmanys(3+4*i, 14, 1, 7, [['merge', 'all'], ['value', 'Class: '+board.getvalue(99+i*100, 4)], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(4+4*i, 14, 1, 6, [['merge', 'all'], ['value', 'Difficulty: '+board.getvalue(99+i*100, 5)], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(5+4*i, 14, 1, 10, [['merge', 'all'], ['value', 'Current enemy: '+enemyname], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(4+4*i, 20, 1, 4, [['merge', 'all'], ['value', 'Wave: '+board.getvalue(99+i*100, 15)], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(3+4*i, 21, 1, 4, [['merge', 'all'], ['value', 'Items: '+itemnum], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(3+4*i, 25, 1, 3, [['merge', 'all'], ['value', 'Level: '+board.getvalue(99+i*100, 6)], ['border', ['top', 'left', 'right', 'bottom']]])
      board.setmanys(4+4*i, 24, 1, 4, [['merge', 'all'], ['value', 'HP: '+board.getvalue(101+i*100, 4)+'/'], ['border', ['top', 'left', 'right', 'no bottom']]])
      board.setmanys(5+4*i, 24, 1, 4, [['merge', 'all'], ['value', board.getvalue(101+i*100, 5)], ['border', ['no top', 'left', 'right', 'bottom']], ['horizalign', 'right']])
    }
  }

  //Make the title screen button
  board.setmanys(19, 15, 3, 10, [['merge', 'all'], ['value', 'Back to Title Screen'], ['color', '#cfe2f3'], ['fontsize', 21], ['border', ['top', 'left', 'right', 'bottom']], ['vertalign', 'middle'], ['horizalign', 'center']])

  //Make the Cond. Form. button
  board.setmanys(2, 16, 4, 8, [['merge', 'all'], ['value', 'Conditional Formatting'], ['color', '#b6d7a8'], ['fontsize', 21], ['border', ['top', 'left', 'right', 'bottom']], ['vertalign', 'middle'], ['horizalign', 'center'], ['wrap', true]])

  //Make the logbook button if Alex has given it to you
  if (board.getvalue(499, 19)==1) {
    board.setmanys(23, 16, 3, 8, [['merge', 'all'], ['value', 'Logbook'], ['color', '#b6d7a8'], ['fontsize', 21], ['border', ['top', 'left', 'right', 'bottom']], ['vertalign', 'middle'], ['horizalign', 'center']])
  }
}

