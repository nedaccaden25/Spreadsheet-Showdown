function detectitems(listtocheck, board) {
  Logger.log("detectitems, 729")
  //Get the items from the board
  let items = board.getitemlist()

  //Make an array to store the results for each item to check for
  let returnarr = []

  //Check for each item in the list
  for (let i=0; i<listtocheck.length; i++) {
    for (let j=0; j<items.length; j++) {
      if (items[j][1]==listtocheck[i] && items[j][3]=='#d9d9d9') {returnarr.push(items[j][0]); break}
    }
    if (returnarr.length==i) {returnarr.push(0)}
  }

  return(returnarr)
}

function detectspells(listtocheck, board) {
  Logger.log("detectspells, 748")
  //Get the spells from the board
  let spells = board.getspelllist()

  //Make an array to store the results for each item to check for
  let returnarr = []

  //Check for each item in the list
  for (let i=0; i<listtocheck.length; i++) {
    for (let j=0; j<spells.length; j++) {
      if (spells[j][0]==listtocheck[i] && spells[j][3]!='#000000') {returnarr.push(true); break}
    }
    if (returnarr.length==i) {returnarr.push(false)}
  }

  return(returnarr)
}

function whatwasselected(row, col, board) {
  Logger.log("whatwasselected, 767")
  //Simply returns whatever element of the game board was selected in order to take the appropriate actions
  //Either returns [selectedthing], ['item', indexofitem], or ['spell', indexofspell]
  if (row==0 && col==0) {return(['inventory'])}
  else if (row>=2 && row<=21 && col>=0 && col<=7) {return(['item', row-1])}
  else if (row==22 && col==0) {return(['class'])}
  else if (row==22 && col>=4 && col<=5) {return(['level'])}
  else if (row>=22 && row<=23 && col>=7 && col<=11) {return(['exp'])}
  else if (row>=24 && row<=26 && col>=0 && col<=11) {return(['hp'])}
  else if (row==27 && col>=0 && col<=2) {return(['atk'])}
  else if (row==29 && col>=0 && col<=2) {return(['def'])}
  else if (row==27 && col>=6 && col<=10) {return(['mag'])}
  else if (row==29 && col>=6 && col<=10) {return(['luck'])}
  else if (row==0 && col>=12 && col<=26) {return(['difficulty'])}
  else if (row==2 && col==12) {return(['enemyname'])}
  else if (row>=2 && row<=4 && col>=18 && col<=27) {return(['enemyhp'])}
  else if (row==5 && col>=18 && col<=22) {return(['enemyatk'])}
  else if (row==5 && col>=23 && col<=27) {return(['enemydef'])}
  else if (row>=25 && row<=31 && col==12) {return(['display'])}
  else if (row==2 && col>=28 && col<=32) {return(['turns'])}
  else if (row==2 && col>=34 && col<=38) {return(['waves'])}
  else if (row==0 && col>=28 && col<=30) {return(['bits'])}
  else if (row==0 && col>=33 && col<=35) {return(['chips'])}
  else if (row==0 && col==38) {return(['exit'])}
  else if (row==5 && col==28) {return(['spellbook'])}//
  else if (row>=7 && row<=30 && col>=28 && col<=38) {return(['spell', ((row+1)/2)-3])}
  else if (row>=7 && row<=24 && col>=12 && col<=27) {
    if (board.getenemyname()!='Rewards:' && board.getenemyname()!='Shop') {return(['enemy picture'])}
    else if (board.getenemyname()=='Rewards:') {
      if (row==7 && col==12) {return(['skip rewards'])}
      else if (row>=7 && row<=8 && col==24) {return(['choices left'])}
      else if (row>=8 && row<=10 && col==18) {return(['reward', 0])}
      else if (row>=12 && row<=14 && col==13) {return(['reward', 1])}
      else if (row>=12 && row<=14 && col==18) {return(['reward', 2])}
      else if (row>=12 && row<=14 && col==23) {return(['reward', 3])}
      else if (row>=16 && row<=18 && col==13) {return(['reward', 4])}
      else if (row>=16 && row<=18 && col==18) {return(['reward', 5])}
      else if (row>=16 && row<=18 && col==23) {return(['reward', 6])}
      else if (row>=20 && row<=22 && col==13) {return(['reward', 7])}
      else if (row>=20 && row<=22 && col==18) {return(['reward', 8])}
      else if (row>=20 && row<=22 && col==23) {return(['reward', 9])}
      else {return(['reward', -1])}
    } else if (board.getenemyname()=='Shop') {
      if (row==7 && col==12) {return(['leave shop'])}
      else if (row>=7 && row<=8 && col==24 ) {return(['refresh shop'])}
      else if (row>=8 && row<=11 && col==18) {return(['shop item', 0])}
      else if (row>=13 && row<=16 && col==13) {return(['shop item', 1])}
      else if (row>=13 && row<=16 && col==18) {return(['shop item', 2])}
      else if (row>=13 && row<=16 && col==23) {return(['shop item', 3])}
      else if (row>=18 && row<=21 && col==13) {return(['shop item', 4])}
      else if (row>=18 && row<=21 && col==18) {return(['shop item', 5])}
      else if (row>=18 && row<=21 && col==23) {return(['shop item', 6])}
      else {return(['shop item', -1])}
    }
  }
  else {return(['unknown'])}
}

function askaboutspell(index, board) {
  Logger.log("askaboutspell, 825")
  let helpermessage = ''
  //Check if this is a closed Spell Slot
  if (board.getspellcolor(index)=='#999999') {
    Browser.msgBox('This is a closed Spell Slot', 'A closed Spell Slot cannot be used at all', Browser.Buttons.OK)
    return('closed')
  }

  //Check if this Spell Slot is empty
  if (board.getspellname(index)=='') {
    Browser.msgBox('This is an empty Spell Slot', 'This Spell Slot has nothing in it, if you find a spell you can put it in your Spellbook', Browser.Buttons.OK)
    return('empty')
  }

  //Check if this spell is disabled
  if (board.getspellcolor(index)=='#000000') {
    helpermessage = board.getspellname(index)+' is disabled right now, casting it will result in a weak, standard attack'
  }

  //Check if this spell has a pop-up covering it
  if (board.getspellcolor(index)=='#ea9999') {
    helpermessage = board.getspellname(index)+' is covered by a pop-up which will attack you if you try to cast '+board.getspellname(index)+', then the pop-up will disappear'
  }

  //Ask if this spell is to be cast
  let yesno = Browser.msgBox('Cast '+board.getspellname(index)+'?', helpermessage, Browser.Buttons.YES_NO)

  //If this spell is to be cast, check if it can be cast right now (testing)
  if (yesno=='yes') {
  //if (true) {
    //If the rewards screen or shop is currently up and you are not casting specifically CHOOSE or FISHER, display an error
    if ((board.getenemyname()=='Rewards:' || board.getenemyname()=='Shop') && board.getspellname(index)!='CHOOSE' && board.getspellname(index)!='FISHER') {
      Browser.msgBox('Spells cannot be cast now', 'Spells cannot be cast between waves', Browser.Buttons.OK)
      return('nothing')
    }

    //If the rewards screen is not up and you try to cast specifically CHOOSE or FISHER, display an error
    //(unless you don't have another spell to cast)
    if (board.getenemyname()!='Rewards:' && (board.getspellname(index)=='CHOOSE' || board.getspellname(index)=='FISHER')) {
      let flag = false
      for (let i=1; i<=12; i++) {
        if (board.getspellname(i)!='CHOOSE' && board.getspellname(i)!='FISHER' && board.getspellname(i)!='' && board.getspellcharges(i)>0) {flag=true}
      }
      if (flag) {
        Browser.msgBox('Cannot cast '+board.getspellname(index)+' right now', board.getspellname(index)+' can only be cast between waves', Browser.Buttons.OK)
        return('nothing')
      }
    }

    //If the two previous checks failed, this spell can be cast
    return('cast')
  }

  //Otherwise, ask if this spell is to be removed
  yesno = Browser.msgBox('Remove '+board.getspellname(index)+' from your Spellbook?', 'Removing this spell will allow you to hold another spell in its place, but you will no longer be able to cast this spell', Browser.Buttons.YES_NO)

  //Remove the spell if desired, otherwise do nothing
  if (yesno=='yes') {return('remove')} else {return('nothing')}
}

function doturn(index, board) {
  Logger.log("doturn, 880")
  //Clear the display if the spell cast wasn't CHOOSE or FISHER
  if (board.getspellname(index)!='CHOOSE' && board.getspellname(index)!='FISHER') {
    board.cleardisplay()
  }

  //Cast the selected spell
  let spellcast = cast(index, board)

  //Check if the rest of the turn needs to happen after this (i.e. the spell was cast successfully and wasn't CHOOSE or FISHER)
  if (spellcast==1) {
    //Decrement buffs
    decturnbuffs(board)

    //Handle miscellaneous debuffs
    //Poison
    if (board.getplayerpoison()==1 && board.getenemycurrenthp()>0) {
      //Deal 1/16 of player max HP as damage if they're poisoned
      dealdamage(Math.ceil(board.getplayermaxhp()/16), 'direct', 0, 0, 0, 'player', 'Your poison hurt you', [], 0.2, board)
    }

    //Apply the changes and wait for a split second while recalculating stats in case a buff ran out
    recalculatestats(0, board)
    board.pause(0.5)

    //Check if you're still alive
    if (board.getplayercurrenthp()==0) {
      return(-1)
    }

    //Check if the enemy is still alive
    else if (board.getenemycurrenthp()==0) {
      return(1)
    } else {

      //If the enemy is still alive, handle its turn now
      enemyturn(board)

      //Check if you're dead
      //If both the enemy and you died on the same turn, the run should still end, so this is checked first
      if (board.getplayercurrenthp()==0) {
        return(-1)
      }

      //Handle the enemy's poison
      if (board.getenemycurrenthp()>0 && board.getenemypoison()==1) {
        dealdamage(Math.ceil(board.getenemymaxhp()/8), 'direct', 0, 0, 0, 'enemy', "The enemy's poison hurt them", [], 0.2, board)
      }

      //Check if the enemy killed itself on its turn
      if (board.getenemycurrenthp()==0) {
        //Since the enemy is dead, return a value indicating as such
        return(1)
      }

      //Update the turn counter if noboody died
      board.setturncount(board.getturncount()+1)
    }
  }
}

function cast(index, board) {
  Logger.log("cast, 941")

  //If this spell is covered with a pop-up, do damage to yourself and remove the pop-up
  if (board.getspellcolor(index)=='#ea9999') {
    board.setspellcolor(index, '#ddbc9a')
    dealdamage(10, 'default', board.getplayeratk(), board.getplayerdef(), board.getplayerluck(), 'player', 'The pop-up caused '+board.getspellname(index)+' to backfire', [], 0.2, board)
    return(1)
  }

  //If this spell is disabled, do a failed cast
  if (board.getspellcolor(index)=='#000000') {
    dealdamage(5, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You tried to cast the disabled '+board.getspellname(index), [], 0.2, board)
    return(1)
  }

  //Check if you are using a spell with no charges
  if (board.getspellcharges(index)==0) {
    //If that is your only spell, do a struggle
    if (board.getnumberofspells()==1) {
      dealdamage(5, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You helplessly swipe at the enemy', [], 0.2, board)
      return(1)
    } else {
      //The only way to trigger this text box is to remove your starting spell, deplete all your spell charges, then get a new spell that has charges and try to cast the spell with none
      Browser.msgBox('That spell has no charges', 'You cannot cast a spell with no charges', Browser.Buttons.OK)
      return(0)
    }
  }

  //Time for a giant switch case of every possible spell that could be cast
  switch(board.getspellname(index)) {
    case 'POW':
      //Infinite charges, 15 power, use ATK
      dealdamage(15, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast POW', [], 0.2, board)
      break
    case 'CHAR':
      //Infinite charges, 15 power, use MAG
      dealdamage(15, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast CHAR', [], 0.2, board)
      break
    case 'POISSON':
      //Infinite charges, 10 power, does extra damage when critting, use ATK
      dealdamage(10, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast POISSON', ['hypercrit'], 0.2, board)
      break
    case 'EXACT':
      //Infinite charges, 10 power, use ATK+DEF
      dealdamage(10, 'standard', board.getplayerdef()+board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast EXACT', [], 0.2, board)
      break
    case 'PROPER':
      //40 charges, 10 power, use MAG
      dealdamage(10, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast PROPER', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'CLEAN':
      //Infinite charges, heals 25% MAX HP
      heal(25, 'percent', 'player', 'You cast CLEAN', board)
      break
    case 'RANK':
      //Infinite charges, 15 power but increased to up to 60 depending on how much higher your ATK is compared to the enemy's, use ATK
      //boost gets set to 4-enemyatk/atk, so the higher your atk is, the less gets subtracted from 4
      boost = 1
      if (board.getplayeratk()!=0) {boost = Math.min(Math.max(4-board.getenemyatk()/board.getplayeratk(), 1), 4)}
      dealdamage(15*boost, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast RANK', [], 0.2, board)
      break
    case 'INTERCEPT':
      //20 charges, reduce enemy ATK and DEF by 30% (THE BOSS only gets reduced by 10%)
      if (board.getenemyname()=='THE BOSS') {
        board.setenemyatk(Math.floor(board.getenemyatk()*0.9))
        board.setenemydef(Math.floor(board.getenemydef()*0.9))
        text('You cast INTERCEPT, THE BOSS somewhat resisted the effect.', 0.2, 0, board)
      } else {
        board.setenemyatk(Math.floor(board.getenemyatk()*0.7))
        board.setenemydef(Math.floor(board.getenemydef()*0.7))
        text('You cast INTERCEPT, the enemy has been weakened!', 0.2, 0, board)
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SUBTOTAL':
      //Infinite charges, power increases with diminishing returns with the total # of items and spell charges you have (∞=20), use ATK
      //Get the # of items, # of spell charges/2, & # of infinites and add them all together (infinities * 10)
      let items = board.getnumberofitems()
      let charges = board.getnumberofspellcharges()
      let total = Number(items) + (Number(charges[0])/2) + (Number(charges[1])*10)
      
      //Now do some math (IDK, plug it into Desmos, it's diminishing returns. Math.log() is natural log (ln) for some reason)
      //let subpower = Math.floor((Math.log(total)/Math.log(1.005))/20-5)    OLD EQUATION ROSE AND FLATTENED TOO QUICKLY
      let subpower = Math.floor((Math.log((total/100)+1)/Math.log(1.004))/5)
      dealdamage(subpower, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast SUBTOTAL', [], 0.2, board)
      break
    case 'BASE':
      //15 charges, 40 power, use MAG
      dealdamage(40, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast BASE', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'LET':
      //10 charges, 50 power, use MAG
      dealdamage(50, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast LET', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'INT':
      //30 charges, 30 power, use MAG
      dealdamage(30, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast INT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SQRT':
      //25 charges, 30 power, use ATK
      dealdamage(30, 'standard', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast SQRT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'MOD':
      //10 charges, 40 power, use ATK
      dealdamage(40, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast MOD', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'VALUE':
      //15 charges, heals 40% MAX HP
      heal(40, 'percent', 'player', 'You cast VALUE', board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SKEW':
      //10 charges, randomly chooses power (average is 46), use MAG
      let skewr = Math.random()
      let skewpower
      let skewmessage
      if (skewr>0.99) {skewpower=200; skewmessage='incredibly'}           //1.00>=r>0.99, 01%: 200 power
      else if (skewr>0.9) {skewpower=100; skewmessage='very strongly'}    //0.99>=r>0.90, 09%: 100 power
      else if (skewr>0.8) {skewpower=80; skewmessage='strongly'}          //0.90>=r>0.80, 10%: 80  power
      else if (skewr>0.6) {skewpower=50; skewmessage='pretty well'}       //0.80>=r>0.60, 20%: 50  power
      else if (skewr>0.4) {skewpower=40; skewmessage='decently'}          //0.60>=r>0.40, 20%: 40  power
      else if (skewr>0.2) {skewpower=30; skewmessage='normally'}          //0.40>=r>0.20, 20%: 30  power
      else if (skewr>0.1) {skewpower=20; skewmessage='poorly'}            //0.20>=r>0.10, 10%: 20  power
      else {skewpower=10; skewmessage='very poorly'}                      //0.10>=r>=0.0, 10%: 10  power
      dealdamage(skewpower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast SKEW '+skewmessage, [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'ADDRESS':
      //30 charges, gives a shield
      board.setplayershield(1)
      text('You cast ADDRESS, you now have a shield!', 0.2, 0, board)
      board.updateplayerhpbar()
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'BITLSHIFT':
      //10 charges, heal an amount equal to your current HP (double your current HP)
      heal(board.getplayercurrenthp(), 'flat', 'player', 'You cast BITLSHIFT', board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'BITRSHIFT':
      //10 charges, halve the enemy's current HP (THE BOSS's HP gets reduced to 80% of the current HP)
      let shiftpower = Math.ceil(board.getenemycurrenthp()/2)
      let shiftmes = ''
      if (board.getenemyname()=='THE BOSS') {
        shiftpower = Math.ceil(board.getenemycurrenthp()/5)
        shiftmes = ', THE BOSS resisted it'
      }
      dealdamage(shiftpower, 'direct', 0, 0, 0, 'enemy', 'You cast BITRSHIFT'+shiftmes, [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'FLATTEN':
      //20 charges, 40 power and reduces enemy DEF by 15%, use ATK
      dealdamage(40, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast FLATTEN', [], 0.2, board)
      board.setenemydef(Math.ceil(board.getenemydef()*0.85))
      text('The enemy has been weakened!', 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'MAKEARRAY':
      //20 charges, sets all enemy stats equal to the median stat (THE BOSS's HP will not be changed, but it is still used to find median)
      //Put the HP in the highest spot and ATK in the second spot
      let highest = board.getenemymaxhp()
      let middle = board.getenemyatk()

      //If the ATK is higher than the highest spot, shift the highest spot down and put ATK above it
      if (middle>=highest) {middle=highest; highest=board.getenemyatk()}

      //If the DEF is higher than the highest spot, shift the highest spot down, otherwise check if DEF is higher than the lower stat, if it is, replace it with DEF, otherwise do nothing
      if (board.getenemydef()>=highest) {middle=highest}
      else if (board.getenemydef()>=middle) {middle=board.getenemydef()}

      //Change the appropriate stats
      if (board.getenemyname()=='THE BOSS') {
        board.setenemyatk(middle)
        board.setenemydef(middle)
        text("You cast MAKEARRAY, but THE BOSS's HP resisted the change.", 0.2, 0, board)
      } else {
        board.setenemymaxhp(middle)
        if (board.getenemycurrenthp()>=middle) {board.setenemycurrenthp(middle)}
        board.setenemyatk(middle)
        board.setenemydef(middle)
        text('You cast MAKEARRAY, the enemy has been normalized!', 0.2, 0, board)
        board.updateenemyhpbar()
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TREND':
      //5 charges, give the player a buff that lasts 5 waves and boosts LUCK by 100% while active
      board.settrendbuff(1)
      text('You cast TREND, you feel luckier already!', 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TIMEVALUE':
      //15 charges, 40 power, but that is increased by 10 for each turn past the first, use MAG
      timepower = (board.getturncount()-1)*10
      dealdamage(40+timepower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast TIMEVALUE', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'MATCH':
      //10 charges, 50 power, use higher between ATK and MAG
      let matchstat
      if (board.getplayeratk()>board.getplayermag()) {matchstat=board.getplayeratk()} else {matchstat=board.getplayermag()}
      dealdamage(50, 'standard', matchstat, board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast MATCH', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'NOT':
      //10 charges, 40 power, use enemy ATK
      dealdamage(40, 'standard', board.getenemyatk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast NOT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'OFFSET':
      //20 charges, 40 power but increased to up to 80 depending on how much higher your MAG is compared to your ATK, use MAG
      offsetdiff=0

      //offsetdiff is set to 1+(MAG-ATK)/MAG, which grows with more MAG and shrinks with more ATK, but will never be greater than 2
      if (board.getplayermag()-board.getplayeratk()>=0) {offsetdiff=1+(board.getplayermag()-board.getplayeratk())/board.getplayermag()}
      dealdamage(40*offsetdiff, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast OFFSET', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'CEILING':
      //10 charges, give the player a buff that lasts for 5 turns and boosts DEF by 100% while active
      board.setceilinginitializer(1)
      text("You cast CEILING, you've fortified yourself!", 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'FLOOR':
      //10 charges, reduce enemy DEF by 50% (THE BOSS's DEF only gets reduced by 25%)
      if (board.getenemyname()=='THE BOSS') {
        board.setenemydef(Math.max(Math.floor(board.getenemydef()*0.75), 1))
        text('You cast FLOOR, THE BOSS somewhat resisted the effect.', 0.2, 0, board)
      } else {
        board.setenemydef(Math.max(Math.floor(board.getenemydef()*0.5), 1))
        text('You cast FLOOR, the enemy has been exposed!', 0.2, 0, board)
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'CONCAT':
      //15 charges, 20 power but add 3 for each character in the enemy's name, use MAG
      let concatpower = board.getenemyname().length
      dealdamage(20+3*concatpower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast CONCAT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'CONVERT':
      //15 charges, 50 power, use LUCK
      dealdamage(50, 'standard', board.getplayerluck(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast CONVERT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'FIXED':
      //10 charges, sets your current HP to 50% of your max HP, rounded down (rounded down to help with "at or below half" synergies)
      board.setplayercurrenthp(Math.floor(board.getplayermaxhp()/2))
      text('You cast FIXED, your HP has been set to half', 0.2, 0, board)
      board.updateplayerhpbar()
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TOCOL':
      //15 charges, gives the player a buff that lasts for 5 turns and increases MAG by 50% of ATK while reducing ATK by that amount
      //Disables the TOROW buff since these two buffs are mutually exclusive
      board.settorowbuff(0)
      board.settocolinitializer(1)
      text("You cast TOCOL, you can feel the magic flowing through you!", 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TOROW':
      //15 charges, gives the player a buff that lasts for 5 turns and increases ATK by 50% of MAG while reducing MAG by that amount
      //Disables the TOCOL buff since these two buffs are mutually exclusive
      board.settocolbuff(0)
      board.settorowinitializer(1)
      text("You cast TOROW, you can feel the strength flowing through you!", 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TRANSPOSE':
      //5 charges, swap the enemy's ATK and DEF
      transposecompare=board.getenemyatk()
      board.setenemyatk(board.getenemydef())
      board.setenemydef(transposecompare)
      text("You cast TRANSPOSE, the enemy's strengths have been inverted!", 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SPARKLINE':
      //15 charges, deals 10% of player's max HP as recoil, uses ATK
      dealdamage(70, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast SPARKLINE', [], 0.2, board)
      dealdamage(Math.floor(board.getplayermaxhp()/10), 'direct', 0, 0, 0, 'player', 'You took recoil damage', ['nonlethal'], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'GAMMA':
      //15 charges, deals 1/8 of the enemy's max HP per turn after casting, uses ATK
      gammaextra = dealdamage(20, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast GAMMA', [], 0.2, board)
      if (board.getenemypoison()==0 && board.getenemymaxhp()>0 && !gammaextra[3].includes('shield')) {
        text('The enemy has been poisoned!', 0.2, 0, board)
        board.setenemyheartcolor('#8e7cc3')
        board.setenemypoison(1)
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'GROWTH':
      //5 charges, give the player a buff that lasts for 5 turns and boosts ATK, DEF, and MAG by 20% for each turn the buff is active
      board.setgrowthinitializer(1)
      text('You cast GROWTH, you can feel the power brewing!', 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SIGN':
      //10 charges, 60 power but increased by 1 minus the ratio of the enemy's current HP and its max HP, use MAG
      signratio = board.getenemycurrenthp()/board.getenemymaxhp()
      dealdamage(60*(2-signratio), 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast SIGN', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'EFFECT':
      //5 charges, reduce the enemy's current HP by double your MAG stat
      let effectpower = board.getplayermag()*2
      dealdamage(effectpower, 'direct', 0, 0, 0, 'enemy', 'You cast EFFECT', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SWITCH':
      //10 charges, swap your current HP with the enemy's (if THE BOSS has more HP than the player, only 20% of the difference is taken)
      //If the enemy has a shield, nothing happens and the shield stays intact
      if (board.getenemyshield()==1) {
        text("You cast SWITCH, but the enemy's shield resisted the change!", 0.2, 0, board)
        decrementcharges(index, 'use RANDARRAY', 1, board)
        break
      }
      let switchenemyhp=board.getenemycurrenthp()
      let switchplayerhp=board.getplayercurrenthp()
      if (board.getenemyname()=='THE BOSS' && switchenemyhp>switchplayerhp) {
        board.setplayercurrenthp(Math.min(Math.ceil((switchenemyhp-switchplayerhp)/5)+switchplayerhp, board.getplayermaxhp()))
        board.setenemycurrenthp(switchenemyhp-Math.ceil((switchenemyhp-switchplayerhp)/5))
        text('You cast SWITCH, you got some HP, but THE BOSS resisted the effect.', 0.2, 0, board)
      } else {
        board.setplayercurrenthp(Math.min(switchenemyhp, board.getplayermaxhp()))
        board.setenemycurrenthp(Math.min(switchplayerhp, board.getenemymaxhp()))
        text('You cast SWITCH, you and the enemy swapped HP!', 0.2, 0, board)
      }
      board.updateenemyhpbar()
      board.updateplayerhpbar()
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'LOG':
      //10 charges, 80 power but increases to 120 if BASE is in your spellbook, use MAG
      //Detect the presence of certain spells
      let logpower = 80
      let base = detectspells('BASE', board)
      if (base[0]) {logpower=logpower*1.5}

      dealdamage(logpower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast LOG', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'RADIANS':
      //15 charges, 20 power but increases by 10 for each PI in your inventory, up to 8 times, use ATK
      //Detect the presence of certain items
      let radianpicount = detectitems(['PI'], board)[0]
      let radianpower = Math.min((radianpicount/2)+1, 5)
      dealdamage(20*radianpower, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast RADIANS', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'DEGREES':
      //10 charges, 75 power but reduced by 15 for each PI in your inventory, up to 4 times, use ATK
      //Detect the presence of certain items
      let degreepicount = detectitems(['PI'], board)[0]
      let degreepower = Math.max(5-degreepicount, 1)
      dealdamage(15*degreepower, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast DEGREES', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'STANDARDIZE':
      //5 charges, reduce the enemy's highest stat by 50% (THE BOSS only reduces the highest between ATK and DEF by 25%)
      let standhp = board.getenemymaxhp()
      let standhpbool = false
      let standatk = board.getenemyatk()
      let standatkbool = false
      let standdef = board.getenemydef()
      let standdefbool = false
      if (board.getenemyname()=='THE BOSS') {
        //Determine which stat is the highest (if some tie, they are BOTH considered the highest)
        if (standatk>=standdef) {standatkbool=true}
        if (standdef>=standatk) {standdefbool=true}

        //Reduce the stats, rounding down, but capping at 1
        if (standatkbool) {board.setenemyatk(Math.max(Math.floor(board.getenemyatk()*0.75), 1))}
        if (standdefbool) {board.setenemydef(Math.max(Math.floor(board.getenemydef()*0.75), 1))}
        text('You cast STANDARDIZE, but THE BOSS somewhat resisted the effect', 0.2, 0, board)
      } else {
        //Determine which stat is the highest (if some tie, they are BOTH considered the highest)
        if (standhp>=standatk && standhp>=standdef) {standhpbool=true}
        if (standatk>=standhp && standatk>=standdef) {standatkbool=true}
        if (standdef>=standhp && standdef>=standatk) {standdefbool=true}

        //Reduce the stats, rounding down, but capping at 1, and adjusting the current HP to make sure it's not greater than the new max
        //If the HP would be changed, ignore the change if the enemy has a shield and break the shield
        text("You cast STANDARDIZE, the enemy's strengths were weakened!", 0.2, 0, board)
        if (standhpbool) {
          if (board.getenemyshield()==1) {text("The enemy's shield resisted the change to HP!", 0.2, 0, board); board.setenemyshield(0)}
          else {
            board.setenemymaxhp(Math.max(Math.floor(board.getenemymaxhp()/2), 1))
            if (board.getenemycurrenthp()>=board.getenemymaxhp()) {board.setenemycurrenthp(board.getenemymaxhp())}
          }
          board.updateenemyhpbar()
        }
        if (standatkbool) {board.setenemyatk(Math.max(Math.floor(board.getenemyatk()/2), 1))}
        if (standdefbool) {board.setenemydef(Math.max(Math.floor(board.getenemydef()/2), 1))}
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SUBSTITUTE':
      //10 charges, replace the enemy's ATK and DEF with the yours (Only a fifth of THE BOSS's stats will be converted if they're greater)
      //This is written like this since the unique boss resistance text should appear if either stat or both was greater than the player's
      if (board.getenemyname()=='THE BOSS' && board.getenemyatk()>board.getplayeratk()) {
        board.setenemyatk(Math.max(Math.floor((board.getenemyatk()*4+board.getplayeratk())/5), 1))
        if (board.getenemydef()>board.getplayerdef()) {
          board.setenemydef(Math.max(Math.floor((board.getenemydef()*4+board.getplayerdef())/5), 1))
          text('You cast SUBSTITUTE, but THE BOSS somewhat resisted the effect', 0.2, 0, board)
        } else {
          board.setenemydef(board.getplayerdef())
          text('You cast SUBSTITUTE, but THE BOSS somewhat resisted the effect', 0.2, 0, board)
        }
      } else {
        board.setenemyatk(board.getplayeratk())
        if (board.getenemyname()=='THE BOSS' && board.getenemydef()>board.getplayerdef()) {
          board.setenemydef(Math.max(Math.floor((board.getenemydef()*4+board.getplayerdef())/5), 1))
          text('You cast SUBSTITUTE, but THE BOSS somewhat resisted the effect', 0.2, 0, board)
        } else {
          board.setenemydef(board.getplayerdef())
          text('You cast SUBSTITUTE, your stats have been transferred to the enemy!', 0.2, 0, board)
        }
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'PERCENTILE':
      //15 charges, 50 power but triples in power when the player's current HP is at or lower than 50% of their max HP, use MAG
      let percentpower=50
      if (board.getplayercurrenthp()/board.getplayermaxhp()<=0.5) {percentpower=percentpower*3}
      dealdamage(percentpower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast PERCENTILE', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'DOLLAR':
      //100 charges, 7 power but can be cast multiple times at once (1, 5, 10, or 25), calculating each cast seperately, use ATK
      //Ask how many times to cast, and make sure it is one of the numbers that can be cast
      let dollarcasts = Browser.inputBox('How many times do you want to cast DOLLAR?', 'Must be exactly 1, 5, 10, or 25 times', Browser.Buttons.OK_CANCEL)
      if (dollarcasts == 'cancel') {return(0)}
      if (dollarcasts!=1 && dollarcasts!=5 && dollarcasts!=10 && dollarcasts!=25) {
        Browser.msgBox('Invalid number', 'You must cast DOLLAR exactly 1, 5, 10, or 25 times', Browser.Buttons.OK)
        return(0)
      }

      //Make sure you have enough charges to cast it that many times
      //Don't need a special message for when you only choose 1 because that means you have 0 and the code already checked for that
      if (board.getspellcharges(index)<dollarcasts) {
        Browser.msgBox('Not enough spell charges', 'You do not have enough charges left to cast DOLLAR '+dollarcasts+' times', Browser.Buttons.OK)
        return(0)
      }

      //Do the attacks
      let dollarmes = 'You cast DOLLAR 1 time'
      if (dollarcasts>1) {dollarmes = 'You cast DOLLAR '+dollarcasts+' times'}
      multiattack(7, dollarcasts, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', dollarmes, [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', dollarcasts, board)
      break
    case 'UNIQUE':
      //30 charges, 40 power but increases to 200 if this is the only spell in your spellbook, use MAG
      uniquepower=40
      if (board.getnumberofspells()==1) {uniquepower=200}
      dealdamage(uniquepower, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast UNIQUE', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'SCAN':
      //3 charges, reduce enemy DEF by 75% (THE BOSS's DEF only gets reduced by 30%)
      if (board.getenemyname()=='THE BOSS') {
        board.setenemydef(Math.max(Math.floor(board.getenemydef()*0.7), 1))
        text('You cast SCAN, THE BOSS somewhat resisted the effect.', 0.2, 0, board)
      } else {
        board.setenemydef(Math.max(Math.floor(board.getenemydef()*0.25), 1))
        text("You cast SCAN, the enemy's weaknesses have been revealed!", 0.2, 0, board)
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'QUERY':
      //30 charges, 60 power but doubles if you have a shield, use MAG
      let querypower = 60
      if (board.getplayershield()==1) {querypower = 120}
      dealdamage(querypower, 'magic', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast QUERY', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'CHOOSE':
      //5 charges, this is cast during the rewards screen and rerolls all items that have not been chosen yet
      //If you aren't on the rewards screen, do a weak standard attack
      if (board.getenemyname()!='Rewards:') {
        dealdamage(5, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast CHOOSE incorrectly', [], 0.2, board)
        decrementcharges(index, 'use RANDARRAY', 1, board)
        break
      } else {
        text('You cast CHOOSE, the rewards were refreshed!', 0.2, 0, board)
        torewards(true, board)
        decrementcharges(index, 'use RANDARRAY', 1, board)
        return(0) //Even though the spell was successfully cast, we don't need to handle any other normal part of a turn after this spell
      }
    case 'NOW':
      //3 charges, gives the player a buff and quadruples all stats (not HP) for 1 turn but if the enemy is still alive when the buff runs out, the player's current HP gets reduced by 75%
      board.setnowinitializer(1)
      text("You cast NOW, you feel overwhelming power, it's now or never!", 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'TIME':
      //3 charges, makes the enemy unable to act for this turn and the 2 after it (THE BOSS is entirely immune)
      if (board.getenemyname()=='THE BOSS') {
        text("You cast TIME, but THE BOSS's anger is very hot!", 0.2, 0, board)
        board.setenemynamecolor('#a4c2f4')
      } else {
        board.setenemynamecolor('#3c78d8')
        text('You cast TIME, the enemy was frozen!', 0.2, 0, board)
      }
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'ISBLANK':
      //1 charge, immediately defeats an enemy on any wave that isn't a multiple of 25
      //If you are on a boss, do a weak standard attack instead after confirming
      if (board.getwavecount()%25==0) {
        let isblankmes = 'This enemy is a boss and is immune to ISBLANK.'
        if (board.getenemyname()=='THE BOSS') {isblankmes = 'THE BOSS is immune to ISBLANK.'}
        let isblankyesno = Browser.msgBox('Cannot cast ISBLANK on this', isblankmes+' You can still cast this spell for a weak standard attack if you want. Cast anyways?', Browser.Buttons.YES_NO)
        if (isblankyesno=='yes') {
          dealdamage(5, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast ISBLANK incorrectly', [], 0.2, board)
          decrementcharges(index, 'use RANDARRAY', 1, board)
          break
        } else {return(0)}
      }
      //Set everything to zero to really sell the "disappearing" theme
      board.setenemycurrenthp(0)
      board.setenemymaxhp(0)
      board.setenemyatk(0)
      board.setenemydef(0)
      board.setenemyhpbar()
      board.setcolors(7, 12, 18, 16, '#ffffff')
      text('You cast ISBLANK, the enemy instantly disappeared!', 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'IMAGINARY':
      //1 charge, adds 5 charges to every other spell in your spellbook (not itself)
      for (let i=1; i<=12; i++) {
        if (board.getspellcharges(i)=='') {break}
        if (i!=index) {board.setspellcharges(i, board.getspellcharges(i)+5)}
      }
      text('You cast IMAGINARY, your spells have been refreshed!', 0.2, 0, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
    case 'FISHER':
      //10 charges, this is cast during the rewards screen and rerolls all items that have not been chosen yet while keeping the rarities
      //If you aren't on the rewards screen, do a weak standard attack
      if (board.getenemyname()!='Rewards:') {
        dealdamage(5, 'standard', board.getplayeratk(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast FISHER incorrectly', [], 0.2, board)
        decrementcharges(index, 'use RANDARRAY', 1, board)
        break
      } else {
        let fisherycoords = [12, 16, 20]
        let fisherxcoords = [13, 18, 23]
        let fisherlist = getlistofrewards(board)
        let fishercolors = ['#cccccc', '#a4c2f4', '#93c47d', '#8e7cc3', '#ffd966', '#e69138', '#e06666', '#c27ba0']
        if (board.getcolor(8, 18)=='#ffffff') {generaterewarditem(0, board)} //This result depends on luck, so use the standard generation
        for (i=0; i<3; i++) {
          for (j=0; j<3; j++) {
            if (fishercolors.includes(board.getcolor(fisherycoords[i], fisherxcoords[j]))) {
              let fisheritem = fishercolors.indexOf(board.getcolor(fisherycoords[i], fisherxcoords[j]))
              let fisherheader = 'Item:'; if (fisheritem>3) {fisherheader = 'Spell:'}
              fisheritem = fisherlist[fisheritem][Math.floor(Math.random()*fisherlist[fisheritem].length)]
              if (fisherheader=='Item:') {
                board.setvaluesarr(fisherycoords[i], fisherxcoords[j], 3, 1, [[fisherheader], [fisheritem[0]], [fisheritem[1]]])
              } else {
                board.setvaluesarr(fisherycoords[i], fisherxcoords[j], 3, 1, [[fisherheader], [fisheritem[0]+'('+fisheritem[2]+')'], [fisheritem[1]]])
              }
            }
          }
        }
        text('You cast FISHER, the rewards were swapped!', 0.2, 0, board)
        decrementcharges(index, 'use RANDARRAY', 1, board)
        return(0) //Even though the spell was successfully cast, we don't need to handle any other normal part of a turn after this spell
      }
    case 'TAN':
      //10 charges, 50 power but only appears if you have SIN and COS in your inventory and +50 power per pair of SIN and COS past the first, use MAG
      let tanboost = detectitems(['SIN', 'COS'], board)
      tanboost = Math.max(Math.min(tanboost[0], tanboost[1])-1, 0)
      dealdamage(50+50*tanboost, 'magic', board.getplayermag(), board.getenemydef(), board.getplayerluck(), 'enemy', 'You cast TAN', [], 0.2, board)
      decrementcharges(index, 'use RANDARRAY', 1, board)
      break
  }

  //Indicate that a spell was successfully cast
  return(1)
}

//returns [damage actually dealt, damage that would be dealt, crit?, otherstuff]
//if message is '', then don't pause or display text or update healthbars. Just calculate damage and adjust current HP values
function dealdamage(pow, type, atk, def, luck, target, message, extraeffects, texttimer, board) {
  Logger.log("dealdamage, 1515")
  let total
  let hypothetical
  let crit = false
  let critmodifiers = [1.3, 0.7]
  if (extraeffects.includes('hypercrit')) {critmodifiers = [1.5, 0.5]}
  let otherstuff = []
  let modify = true
  if (message=='') {modify=false}
  //Calculate damage using the damage formula
  if (type!='direct') {
    //Halve luck if playing on CEO difficulty
    if (board.getcurrentdifficulty()=='CEO') {luck=Math.floor(luck/2)}

    //Generate random numbers to modify the damage calculation
    let randatk = Math.random()*0.2+0.9
    let randdef = Math.random()*0.2+0.9
    if (randatk>=1.09*Math.pow(Math.E, -0.005*luck)+1.05*(1-Math.pow(Math.E, -0.005*luck)) || randdef<=0.91*Math.pow(Math.E, -0.005*luck)+0.95*(1-Math.pow(Math.E, -0.005*luck))) {crit = true; randatk = critmodifiers[0]; randdef = critmodifiers[1]}

    //Calculate the amount of damage needed to be dealt
    let numerator = Math.pow(pow, 1.3)*Math.pow(atk+5, 1.8)*randatk
    let denominator = 100*Math.pow(def+5, 50/(pow+125)+0.6)*randdef
    total = Math.ceil(numerator/denominator)
  //Deal the inputted damage directly
  } else {
    total = pow
  }
  hypothetical = total

  //Differentiate between the enemy's attack and yours
  if (target!='enemy') {
    //Detect the presence of certain items
    let items = detectitems(['REDUCE', 'TRUNC', 'UPPER'], board)
    let reduce = items[0]
    let trunc = items[1]
    let upper = items[2]

    //Apply the effects of REDUCE
    if (reduce>0) {
      total = Math.max(total-5*reduce, 1)
    }

    //Cap the damage if it is nonlethal and would kill
    if (extraeffects.includes('nonlethal')) {
      if (board.getplayercurrenthp()-total<=0) {total = board.getplayercurrenthp()-1}
    }

    //Display the damage that would be dealt
    if (modify) {
      if (crit) {text(message+', Critical hit! '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
      else {text(message+', it dealt '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
    }

    //Apply the effects of TRUNC
    if (trunc>0) {
      //Damage cutoff = maxHP*(0.65^((TRUNC+3)/4)+0.25)
      //1 TRUNC -> 90%, infinite TRUNC -> 25%
      let cutoff = Math.floor(board.getplayermaxhp()*(Math.pow(0.65, (trunc+3)/4)+0.25))

      //Cap the damage dealt to the cutoff
      if (total>cutoff) {
        total = cutoff
        otherstuff.push('TRUNC')
        if (modify) {text('TRUNC reduced the damage to only '+total.toLocaleString('en-US')+' damage!', 0.1, 0, board)}
      }
    }

    //Deal no damage if you have a shield
    if (board.getplayershield()==1) {
      board.setplayershield(0)
      otherstuff.push('shield')
      if (modify) {
        text("Your shield blocked all damage!", 0.1, 0, board)
        board.updateplayerhpbar()
      }
      return([0, hypothetical, crit, otherstuff])
    }

    //Check if you died and revive you with UPPER
    if (board.getplayercurrenthp()-total<=0 && upper>0) {
      otherstuff.push('UPPER')
      board.setplayercurrenthp(0)
      if (modify) {
        board.updateplayerhpbar()
        board.pause(0.5)
      }
      board.setplayercurrenthp(Math.floor(board.getplayermaxhp()/2))
      if (modify) {
        text('UPPER revived you!', 0.2, 0, board)
        board.updateplayerhpbar()
      }
      let upperindex
      for (let i=1; i<=20; i++) {if (board.getitemname(i)=='UPPER') {upperindex=i; break}}
      removeitem(1, upperindex, board)
      return([total, hypothetical, crit, otherstuff])
    }

    //Update the current health
    board.setplayercurrenthp(Math.max(board.getplayercurrenthp()-total, 0))
    if (modify) {board.updateplayerhpbar()}

    return([total, hypothetical, crit, otherstuff])

  } else {
    //Greatly reduce the damage dealt if you are fighting THE BOSS and deal more than 1/4 of his hp in one hit (div by 100 after each quarter)
    if (board.getenemyname()=='THE BOSS') {
      let counter = 0
      while (total>Math.ceil(board.getenemymaxhp()/4)) {
        total = Math.ceil((total-Math.ceil(board.getenemymaxhp()/4))/100)
        counter++
      }
      if (counter>0) {otherstuff.push('THE BOSS')}
      total = total+Math.ceil(board.getenemymaxhp()/4)*counter
    }

    //Reduce the damage slightly if the enemy resists this type of spell
    let standardresists = ['Cell Crawler', 'Subtractarine', 'Pensolo', 'Macro Golem', 'Printentacle', 'Penseveral', 'Diviling Cabinet', 'Grand Compiler', 'Micro Golem', 'Crazed Clip']
    let magicresists = ['Cellyfish', 'Adder', 'Row Wraith', 'Shadow Formula', 'Cellystorm', 'Produconda', '#REF! Demon', 'Summatrix', 'Hydraxponent', 'Locked Cell']
    if ((type=='standard' && standardresists.includes(board.getenemyname())) || (type=='magic' && magicresists.includes(board.getenemyname()))) {
      total = Math.ceil(total*0.7)
    }

    //Cap the damage dealt if fighting Penseveral or Hydraxponent and handle the max HP reduction
    if ((board.getenemyname()=='Penseveral' || board.getenemyname()=='Hydraxponent') && board.getenemyvar1()>1 && board.getenemyshield()!=1) {
      let unithp = Math.floor(board.getenemymaxhp()/board.getenemyvar1())
      if (extraeffects.includes('nonlethal')) {
        if (board.getenemycurrenthp()-total<=board.getenemymaxhp()-unithp) {total = board.getenemycurrenthp()-unithp*(board.getenemyvar1()-1)-1}
      }
      if (board.getenemycurrenthp()-total<=board.getenemymaxhp()-unithp) {
        otherstuff.push(board.getenemyname())
        if (modify) {
          if (crit==1) {text(message+', Critical hit! '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
          else {text(message+', it dealt '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
        }
        board.setenemycurrenthp(board.getenemymaxhp()-unithp)
        if (modify) {board.updateenemyhpbar()}
        board.setenemymaxhp(board.getenemycurrenthp())
        if (modify) {board.setenemyhpbar()}  //Set is used because it shouldn't look like a heal
        board.setenemyvar1(board.getenemyvar1()-1)
        if (modify) {
          if (board.getenemyname()=='Penseveral') {
            board.drawsprite('Penseveral', 'default'+(7-board.getenemyvar1()))
            text('One Pensolo was defeated!', 0.1, 0, board)
          } else if (board.getenemyname()=='Hydraxponent') {
            board.drawsprite('Hydraxponent', 'default'+(board.getenemyvar1()-1))
            text('One Hydraxponent head was defeated!', 0.1, 0, board)
          }
        }
        return([total, hypothetical, crit, otherstuff])
      }
    }

    //Cap the damage if it is nonlethal and would kill
    if (extraeffects.includes('nonlethal')) {
      if (board.getplayercurrenthp()-total<=0) {total = board.getplayercurrenthp()-1}
    }

    //Display the damage dealt
    if (modify) {
      if (crit==1) {text(message+', Critical hit! '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
      else {text(message+', it dealt '+total.toLocaleString('en-US')+' damage!', texttimer, 0, board)}
    }

    //Deal no damage if the enemy has a shield
    if (board.getenemyshield()==1) {
      board.setenemyshield(0)
      otherstuff.push('shield')
      if (modify) {
        text("The enemy's shield blocked all damage!", 0.1, 0, board)
        board.updateenemyhpbar()
      }
      return([0, hypothetical, crit, otherstuff])
    }

    //Update the current health
    board.setenemycurrenthp(Math.max(board.getenemycurrenthp()-total, 0))
    if (modify) {
      board.updateenemyhpbar()
    }

    //Return with the damage dealt, in case certain behaviors need it
    return([total, hypothetical, crit, otherstuff])
  }
}

function multiattack(pow, numhits, type, atk, def, luck, target, message, extraeffects, texttimer, board) {
  Logger.log("multiattack, 1765")

  //Calculate the total damage dealt while keeping track of any weird things that happen
  let totaldamage = 0
  let crits = 0
  let shield = 0
  let trunc = 0
  let upper = 0
  let pencils = 0
  let heads = 0
  for (let i=0; i<numhits; i++) {
    let extra = dealdamage(pow, type, atk, def, luck, target, '', extraeffects, texttimer, board)
    totaldamage = totaldamage+extra[0]
    if (extra[2]) {crits++}
    if (extra[3].includes('shield')) {shield = 1}
    if (extra[3].includes('UPPER')) {upper = 1}
    if (extra[3].includes('TRUNC')) {trunc++}
    if (extra[3].includes('Penseveral')) {pencils++}
    if (extra[3].includes('Hydraxponent')) {heads++}
  }

  //Display the message stating exactly how each cast went
  if (crits==1) {message = message+', 1 crit'} else if (crits>1) {message = message+', '+crits+' crits'}
  text(message+', in total it dealt '+totaldamage.toLocaleString('en-US')+' damage!', texttimer, 0, board)

  //Display the shield break message if there was a shield
  if (shield==1) {
    if (target=='player') {text('The first hit was blocked by your shield!', 0.1, 0, board)}
    else {text("The first hit was blocked by the enemy's shield!", 0.1, 0, board)}
  }

  //Update the healthbar
  if (target=='player') {board.updateplayerhpbar()} else {board.updateenemyhpbar()}

  //Display if any items were activated
  if (trunc>0) {text('TRUNC reduced '+trunc+' of the hits!', 0.1, 0, board)}
  if (upper==1) {text('UPPER revived you after one of the hits!', 0.1, 0, board)}

  //Display if any Pensolos or Hydraxponents were killed
  if (pencils>0) {
    board.pause(0.1)
    if (board.getenemycurrenthp()==0) {pencils++} //This is because the last Pensolo killed doesn't inc pencils
    if (pencils==1) {text('1 Pensolo was defeated!', 0.1, 0, board)} else {text(pencils+' Pensolos were defeated!', 0.1, 0, board)}
    if (board.getenemycurrenthp()>0) {board.drawsprite('Penseveral', 'default'+(7-board.getenemyvar1()))}
  }
  if (heads>0) {
    board.pause(0.1)
    if (board.getenemycurrenthp()==0) {heads++} //This is because the last head killed doesn't inc heads
    if (heads==1) {text('1 Hydraxponent head was defeated!', 0.1, 0, board)} else {text(heads+'Hydraxponent heads were defeated!', 0.1, 0, board)}
    if (board.getenemycurrenthp()>0) {board.drawsprite('Hydraxponent', 'default'+(board.getenemyvar1()-1))}
  }
}

function enemyturn(board) {
  Logger.log("enemyturn, 1638")

  //Check if the enemy is frozen by the TIME spell and display the appropriate message while updating the HUD color
  if (board.getenemynamecolor()=='#3c78d8') {
    text('The enemy is frozen solid!', 0.2, 0, board)
    board.setenemynamecolor('#6d9eeb')
    return
  }
  if (board.getenemynamecolor()=='#6d9eeb') {
    text('The enemy is beginning to unthaw...', 0.2, 0, board)
    board.setenemynamecolor('#a4c2f4')
    return
  }
  if (board.getenemynamecolor()=='#a4c2f4') {
    text('The enemy has been unthawed!', 0.2, 0, board)
    board.setenemynamecolor('#d9d9d9')
    return
  }

  //Get the turn number and non-disableable here since many behaviors depend on it
  let turn = board.getturncount()
  let immuneitems = ['JOIN', 'PROB', 'CONFIDENCE', 'RATE', 'QUOTIENT']

  //Time for another giant switch case of all the enemies and their different behaviors
  switch(board.getenemyname()) {
    case 'Green Sheet Slime':
      //Default attack
      board.drawsprite('Green Sheet Slime', 'attack0')
      dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Green Sheet Slime bumped into you', [], 0.2, board)
      board.drawsprite('Green Sheet Slime', 'default0')
      break
    case 'Red Sheet Slime':
      //Medium strength attack that heals itself
      board.drawsprite('Red Sheet Slime', 'attack0')
      let rslimehealed = dealdamage(15, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Red Sheet Slime siphoned life from you', [], 0.2, board)[0]
      board.drawsprite('Red Sheet Slime', 'default0')
      //Heal for a fifth of the damage dealt
      heal(Math.ceil(rslimehealed/5), 'flat', 'enemy', 'The Red Sheet Slime absorbed the life', board)
      break
    case 'Yellow Sheet Slime':
      //Medium strength attack that hurts itself
      board.drawsprite('Yellow Sheet Slime', 'attack0')
      dealdamage(15, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Yellow Sheet Slime threw goop at you', [], 0.2, board)
      board.drawsprite('Yellow Sheet Slime', 'default0')
      //Take 1/10 of max HP as damage after the attack
      dealdamage(Math.ceil(board.getenemycurrenthp()/8), 'direct', 0, 0, 0, 'enemy', 'The Yellow Sheet Slime hurt itself in the process', [], 0.2, board)
      break
    case 'Cellyfish':
      //Default attack
      board.drawsprite('Cellyfish', 'attack0')
      dealdamage(10, 'default', board.getenemyatk(), board.getplayerdef(), 0, 'player', 'The Cellyfish stung you', [], 0.2, board)
      board.drawsprite('Cellyfish', 'default0')
      break
    case 'Adder':
      //The two different paths are just for the different sprites
      if (board.getplayerpoison()!=1 && board.getplayershield()==0) {
        board.drawsprite('Adder', 'attack0')
        //Weak attack that applies a damage-over-time debuff that lasts until the end of the wave
