  }
  if (board.getcurrentdifficulty()=='Manager' && !board.isexecutiveunlocked()) {
    board.unlockexecutive()
    Browser.msgBox('You unlocked the Executive difficulty!', 'By beating the game on Manager difficulty, you unlocked the Executive difficulty to try out in future runs!', Browser.Buttons.OK)
  }
  if (board.getcurrentdifficulty()=='Executive' && !board.isceounlocked()) {
    board.unlockceo()
    Browser.msgBox('You unlocked the CEO difficulty!', 'By beating the game on Executive difficulty, you unlocked the CEO difficulty to try out in future runs!', Browser.Buttons.OK)
  }
  if (board.getcurrentdifficulty()=='Manager' || board.getcurrentdifficulty()=='Executive' || board.getcurrentdifficulty()=='CEO') {
    if (board.getcurrentcharacter()=='Cellblade' && !board.iscellblademastered()) {
      board.mastercellblade()
