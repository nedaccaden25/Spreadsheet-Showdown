  setborder(row, col, details) {
    let topstate = null
    let leftstate = null
    let bottomstate = null
    let rightstate = null
    let color = '#000000'
    let thickness = SpreadsheetApp.BorderStyle.SOLID
    if (details.includes('top')) {topstate = true} else if (details.includes('no top')) {topstate = false}
    if (details.includes('left')) {leftstate = true} else if (details.includes('no left')) {leftstate = false}
    if (details.includes('bottom')) {bottomstate = true} else if (details.includes('no bottom')) {bottomstate = false}
    if (details.includes('right')) {rightstate = true} else if (details.includes('no right')) {rightstate = false}
    for (let i=0; i<details.length; i++) {
      if (typeof details[i] == 'string') {
        if (details[i].includes('#') && details[i].length==7) {color = details[i]; break}
      }
    }
    if (details.includes('medium')) {thickness = SpreadsheetApp.BorderStyle.SOLID_MEDIUM}
    else if (details.includes('thick')) {thickness = SpreadsheetApp.BorderStyle.SOLID_THICK}
    this.sheet.getRange(row+1, col+1).setBorder(topstate, leftstate, bottomstate, rightstate, null, null, color, thickness)
  }

  setborders(row, col, numrows, numcols, details) {
    let topstate = null
    let leftstate = null
    let bottomstate = null
    let rightstate = null
    let vertstate = null
    let horizstate = null
    let color = '#000000'
    let thickness = SpreadsheetApp.BorderStyle.SOLID
    if (details.includes('top')) {topstate = true} else if (details.includes('no top')) {topstate = false}
    if (details.includes('left')) {leftstate = true} else if (details.includes('no left')) {leftstate = false}
    if (details.includes('bottom')) {bottomstate = true} else if (details.includes('no bottom')) {bottomstate = false}
    if (details.includes('right')) {rightstate = true} else if (details.includes('no right')) {rightstate = false}
    if (details.includes('vertical')) {vertstate = true} else if (details.includes('no vertical')) {vertstate = false}
    if (details.includes('horizontal')) {horizstate = true} else if (details.includes('no horizontal')) {horizstate = false}
    for (let i=0; i<details.length; i++) {
      if (typeof details[i] == 'string') {
        if (details[i].includes('#') && details[i].length==7) {color = details[i]; break}
      }
    }
    if (details.includes('medium')) {thickness = SpreadsheetApp.BorderStyle.SOLID_MEDIUM}
    if (details.includes('thick')) {thickness = SpreadsheetApp.BorderStyle.SOLID_THICK}
    this.sheet.getRange(row+1, col+1, numrows, numcols).setBorder(topstate, leftstate, bottomstate, rightstate, vertstate, horizstate, color, thickness)
  }

  setmerge(row, col, numrows, numcols, mode) {
    if (mode=='all') {this.sheet.getRange(row+1, col+1, numrows, numcols).merge()}
    else if (mode=='across') {this.sheet.getRange(row+1, col+1, numrows, numcols).mergeAcross()}
    else if (mode=='vertical') {
      for (let i=0; i<numcols; i++) {
        this.sheet.getRange(row+1, col+1+i, numrows, 1).merge()
      }
    }
  }

