    }
    if (board.getcurrentcharacter()=='Sheetmancer' && !board.issheetmancermastered()) {
      board.mastersheetmancer()
      Browser.msgBox("Congratulations! You've mastered the Sheetmancer!", 'CHAR has been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
    if (board.getcurrentcharacter()=='Rowgue' && !board.isrowguemastered()) {
      board.masterrowgue()
      Browser.msgBox("Congratulations! You've mastered the Rowgue!", 'PROB and POISSON have been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
    if (board.getcurrentcharacter()=='Macroknight' && !board.ismacroknightmastered()) {
      board.mastermacroknight()
      Browser.msgBox("Congratulations! You've mastered the Macroknight!", 'CONFIDENCE and EXACT have been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
    if (board.getcurrentcharacter()=='Stackleric' && !board.isstacklericmastered()) {
      board.masterstackleric()
      Browser.msgBox("Congratulations! You've mastered the Stackleric!", 'RATE, PROPER, and CLEAN have been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
    if (board.getcurrentcharacter()=='Auditshade' && !board.isauditshademastered()) {
      board.masterauditshade()
      Browser.msgBox("Congratulations! You've mastered the Auditshade!", 'QUOTIENT, RANK, and INTERCEPT have been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
    if (board.getcurrentcharacter()=='Hyperlinker' && !board.ishyperlinkermastered()) {
      board.masterhyperlinker()
      Browser.msgBox("Congratulations! You've mastered the Hyperlinker!", 'SUBTOTAL has been added to the permanent pool of rewards', Browser.Buttons.OK)
    }
  }
  if (board.getcurrentdifficulty()=='CEO' && board.getcurrentcharacter()=='Error' && board.getvalue(102+board.getcurrentfilenum()*100, 22)!=1 && !board.iserrormastered()) {
    board.mastererror()
    Browser.msgBox("WOW! You've mastered the game!", 'By beating CEO difficulty as the Error class without dying, YEAR and TAN have been permanently added to the pool of rewards, and YEAR no longer will require DAY, WEEK, or MONTH to give its effect', Browser.Buttons.OK)
  }

  //Delete the completed file, inc the win counter, and go to the credits
  board.setvalues(99+board.getcurrentfilenum()*100, 0, 100, 40, '')
  if (board.getwincount()==-1) {board.setwincount(1)}
  else {board.incwincount()}
  gotocredits(board)
}

function getexp(board) {
  Logger.log("getexp, 2315")

  let exp = 0
  let bits = 0
  let chips = 0

  //Time for another giant switch case to determine the exp and money values for each enemy
  //Also handle the on-death effects of certain enemies here since this is a nice place to do it (even if it is a little unrelated to exp)
  switch(board.getenemyname()) {
    case 'Green Sheet Slime':
      exp = 30
      bits = 3
      break
    case 'Red Sheet Slime':
      exp = 40
      bits = 4
      break
    case 'Yellow Sheet Slime':
      exp = 30
      bits = 3
      break
    case 'Cellyfish':
      exp = 20
      bits = 2
      break
    case 'Adder':
      exp = 30
      bits = 3
      break
    case 'Cell Crawler':
      exp = 35
      bits = 4
      text('You found some supplies inside the Cell Crawler!', 0.1, 0, board)
      text('You can pick 1 extra reward!', 0.1, 0, board)
      break
    case 'Moni-Troll':
      exp = 40
      bits = 4
      break
    case 'Subtractarine':
      exp = 30
      bits = 3
      break
    case 'Pensolo':
      exp = 30
      bits = 3
      break
    case 'Amalgam Sheet Slime':
      exp = 100
      bits = 10
      chips = 1
      break
    case 'Macro Golem':
      exp = 150
      bits = 15
      chips = 1
      break
    case 'Row Wraith':
      exp = 100
      bits = 10
      chips = 1
      break
    case 'Printentacle':
      exp = 120
      bits = 12
      chips = 1
      break
    case 'Shadow Formula':
      exp = 120
      bits = 12
      chips = 1
      break
    case 'Chartclaw':
      exp = 135
      bits = 14
      chips = 1
      break
    case 'Cellystorm':
      exp = 100
      bits = 10
      chips = 1
      break
    case 'Produconda':
      exp = 100
      bits = 10
      chips = 1
      break
    case 'Penseveral':
      exp = 150
      bits = 17
      chips = 2
      break
    case 'Diviling Cabinet':
      exp = 140
      bits = 15
      chips = 2
      text('You found some supplies inside the Diviling Cabinet!', 0.1, 0, board)
      text('1 more option will be available and you can pick 1 extra reward!', 0.1, 0, board)
      break
    case '#REF! Demon':
      exp = 300
      bits = 50
      chips = 5
      break
    case 'Grand Compiler':
      exp = 300
      bits = 50
      chips = 5
      break
    case 'Summatrix':
      exp = 300
      bits = 50
      chips = 5
      break
    case 'Hydraxponent':
      exp = 300
      bits = 50
      chips = 5
      break
    case 'Locked Cell':
      exp = 1500
      bits = 30
      chps = 1
      break
    case 'Micro Golem':
      exp = 750
      bits = 30
      chips = 2
      break
    case 'Crazed Clip':
      exp = 300
      bits = 30
      //Add the bonus spell charges here
      for (let i=1; i<=board.getnumberofspells(); i++) {
        board.setspellcharges(i, board.getspellcharges(i)+5)
      }
      text("All your spells gained 5 charges!", 0.2, 0, board)
      break
    case 'egg':
      exp = 10000
      bits = 200
      chips = 10
      break
  }

  //Do some math to the base exp value of the enemy
  //baseexp*sqrt(wave)*1.3
  exp = exp*Math.pow(board.getwavecount(), 1/2)*1.3

  //Halve the exp gain if playing on CEO
  if (board.getcurrentdifficulty()=='CEO') {exp=exp/2}

  //Detect the presence of certain items
  let items = detectitems(['EXP', 'INTRATE', 'FIND'], board)
  let expitem = items[0]
  let intrate = items[1]
  let finditem = items[2]

  //Apply the effects of the items
  if (expitem>0) {exp=exp*(1+0.05*expitem)}
  if (intrate>0) {exp=exp*(1+0.3*intrate)}
  if (finditem>0) {exp=exp*(1+Math.max(0.6*finditem-0.1*finditem*board.getturncount(), 0))}

  //Round up any remaining decimal component
  exp=Math.ceil(exp)

  //Display a message with how much exp was gained
  text('You gained '+exp.toLocaleString('en-US')+' exp', 0.2, 0, board)

  //Determine if this amount of exp will cause a level up
  if (board.getcurrentexp()+exp>=board.getmaxexp()) {

    //If we level up, call a different function
    exp = levelup(board.getcurrentexp()+exp-board.getmaxexp(), board.getlevel(), board)

    //Completely restore your HP if you are playing on Intern
    if (board.getcurrentdifficulty()=='Intern') {board.setplayercurrenthp(board.getplayermaxhp()); board.updateplayerhpbar()}

  } else {

    //If no level up, store the total amount of exp that you have after the increase
    exp = board.getcurrentexp()+exp
  }

  //Update the current exp number and the exp bar
  board.setcurrentexp(exp)
  board.updateexpbar()

  //Do some math to the base money value of the enemy
  //basemoney*cuberoot(wave)*difficultymodifier
  let difficulties = ['Intern', 'Associate', 'Manager', 'Executive', 'CEO']
  let modifiers = [0.2, 0.3, 0.4, 0.6, 0.8]
  bits = Math.max(Math.floor(bits*Math.cbrt(board.getwavecount())*modifiers[difficulties.indexOf(board.getcurrentdifficulty())]), 1)
  if (chips>0) {
    chips = Math.max(Math.floor(chips*Math.cbrt(board.getwavecount())*modifiers[difficulties.indexOf(board.getcurrentdifficulty())]), 1)
  }

  //Set the values to 1 if the dirty save flag is set
  if (board.getvalue(102+board.getcurrentfilenum()*100, 22)==1) {
    if (bits>0) {bits=1}
    if (chips>0) {chips=1}
  }

  //Update the amount of money you have
  board.addbits(bits)
  board.addchips(chips)

  //Display a message with how much money you got
  if (bits==1) {text('You gained 1 Bit', 0.1, 0, board)}
  else if (bits>1) {text('You gained '+bits.toLocaleString('en-US')+' Bits', 0.1, 0, board)}
  if (chips==1) {text('You gained 1 Chip', 0.1, 0, board)}
  else if (chips>1) {text('You gained '+chips.toLocaleString('en-US')+' Chips', 0.1, 0, board)}
}

function levelup(leftoverexp, currentlevel, board) {
  Logger.log("levelup, 2503")

  //First handle the level up itself
  let newlevel = currentlevel+1
  text('You leveled up to level '+newlevel+'!', 0.2, 0, board)
  board.setlevel(newlevel)

  //Figure out how much experience is needed for the next level and display it
  //100+10*level^2
  let nextmaxexp = 100+Math.pow(newlevel, 2)*10
  board.setmaxexp(nextmaxexp)

  //Recalculate your stats with this new level
  recalculatestats(0, board)

  //Check if we level up again
  if (leftoverexp>=nextmaxexp) {
    leftoverexp = levelup(leftoverexp-nextmaxexp, newlevel, board)
  }

  //Return how much exp is left after leveling up and return the new max exp to calculate the exp bar correctly
  return(leftoverexp)
}

function torewards(choose, board) {
  Logger.log("torewards, 2529")

  //Reset your items if they have been disabled
  for (let i=1; i<=20; i++) {
    board.setitemcolor(i, '#d9d9d9')
  }

  //Reset your spells if they have been disabled (don't reset their color if they aren't open spell slots)
  for (let i=1; i<=12; i++) {
    if (board.getspellcolor(i)!='#999999') {board.setspellcolor(i, '#ddbc9a')}
  }

  //Recalculate your stats in case there were disabled items or spells that were modifying them
  recalculatestats(0, board)

  //Identify all of the rewards that have already been chosen if we are casting the CHOOSE spell
  let blackrewards = []
  if (choose) {
    for (let i=0; i<=9; i++) {
      if (board.getrewardcolor(i)=='#000000') {blackrewards.push(i)}
    }
  } 

  //Clear the enemy's picture/reward colors
  board.setcolors(7, 12, 18, 16, '#ffffff')

  //Set a flag if we fought an enemy that grants extra rewards
  let extrarewards = 0
  let rewardenemies = ['Cell Crawler', 'Diviling Cabinet']
  if (rewardenemies.includes(board.getenemyname())) {extrarewards=1}

  //Set a flag if we fought an enemy that shows extra options
  let extraoptions = 0
  let optionenemies = ['Diviling Cabinet']
  if (optionenemies.includes(board.getenemyname())) {extraoptions=1}

  //Clear the enemy's name and reset the statbox's colors
  board.setmany(2, 12, [['value', 'Rewards:'], ['color', '#d9d9d9'], ['fontsize', 21]])
  board.setcolors(2, 18, 5, 10, '#d9d9d9')

  //Display the take none box
  board.setmanys(7, 12, 1, 4, [['merge', 'all'], ['value', 'Skip Rewards'], ['border', ['top', 'left', 'right', 'bottom']]])

  //Detect the presence of certain items
  let items = detectitems(['SEARCH', 'PRICE'], board)
  let search = items[0]
  let price = items[1]

  //Display the number of rewards that can be selected if CHOOSE has not been cast
  if (!choose) {
    board.setmanys(7, 24, 1, 4, [['merge', 'all'], ['value', 'Choices left:'], ['border', ['top', 'left', 'right', 'bottom']]])
    board.setmanys(8, 24, 1, 4, [['merge', 'all'], ['value', 1+price+extrarewards], ['border', ['top', 'left', 'right', 'bottom']]])
  }

  //Generate all of the items, recoloring them black instead if they were already chosen before casting CHOOSE
  for (let i=0; i<search+extraoptions+4; i++) {
    if (i==10) {break}
    if (!blackrewards.includes(i)) {generaterewarditem(i, board)}
    else {board.setrewardcolor(i, '#000000')}
  }
}

function toshop(board) {
  Logger.log("toshop, 2585")

  //Clear the enemy's name and reset the statbox's colors
  board.setmany(2, 12, [['value', ''], ['color', '#d9d9d9'], ['fontsize', 21]])
  board.setcolors(2, 18, 5, 10, '#d9d9d9')

  //First handle the Alex dialogue
  talktoalex(board)

  //Reset your items if they have been disabled
  for (let i=1; i<=20; i++) {
    board.setitemcolor(i, '#d9d9d9')
  }

  //Reset your spells if they have been disabled (don't reset their color if they aren't open spell slots)
  for (let i=1; i<=12; i++) {
    if (board.getspellcolor(i)!='#999999') {board.setspellcolor(i, '#ddbc9a')}
  }

  //Recalculate your stats in case there were disabled items or spells that were modifying them
  recalculatestats(0, board)

  //Clear Alex's picture
  board.setcolors(7, 12, 18, 16, '#ffffff')

  //Set that we are on the shop screen
  board.setenemyname('Shop')

  //Display the leave shop box
  board.setmanys(7, 12, 1, 4, [['merge', 'all'], ['value', 'Leave Shop'], ['border', ['top', 'left', 'right', 'bottom']]])

  //Display the refresh button
  let difficultymodifier = [1, 0.6]
  if (board.getcurrentdifficulty()=='Associate') {difficultymodifier = [1.5, 0.65]}
  else if (board.getcurrentdifficulty()=='Manager') {difficultymodifier = [2, 0.7]}
  else if (board.getcurrentdifficulty()=='Executive') {difficultymodifier = [2.5, 0.75]}
  else if (board.getcurrentdifficulty()=='CEO') {difficultymodifier = [3, 0.85]}
  //cost = floor(3*diffmod2*shop#^(diffmod1*(1+3/1000)))
  let cost = Math.floor(3*difficultymodifier[1]*Math.pow(board.getwavecount()/25, difficultymodifier[0]+(1+3/1000)))
  board.setmanys(7, 24, 1, 4, [['merge', 'all'], ['value', 'Refresh Shop'], ['border', ['top', 'left', 'right', 'bottom']]])
  board.setmanys(8, 24, 1, 4, [['merge', 'all'], ['value', cost+board.biticon], ['border', ['top', 'left', 'right', 'bottom']]])

  //Generate all of the items
  for (let i=0; i<7; i++) {
    generateshopitem(i, board)
  }
}

